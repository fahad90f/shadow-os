# Shadow OS boot splash (Plymouth "script" module).
#
# Shows the logo with a progress bar; asks for the disk-encryption passphrase
# and shows messages from the boot process. Pressing Escape switches to the
# text log as usual — the splash never hides diagnostics that were asked for.

Window.SetBackgroundTopColor(0.020, 0.027, 0.051);
Window.SetBackgroundBottomColor(0.020, 0.027, 0.051);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
center_x = Window.GetX() + screen_w / 2;
center_y = Window.GetY() + screen_h / 2;

# ---- logo ---------------------------------------------------------------------
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(center_x - logo.image.GetWidth() / 2);
logo.sprite.SetY(center_y - logo.image.GetHeight() / 2 - 60);
logo.sprite.SetZ(10);

# ---- progress -----------------------------------------------------------------
track.image = Image("track.png");
track.sprite = Sprite(track.image);
track.x = center_x - track.image.GetWidth() / 2;
track.y = center_y + 70;
track.sprite.SetPosition(track.x, track.y, 10);

bar.original = Image("bar.png");
bar.sprite = Sprite();
bar.sprite.SetPosition(track.x, track.y, 11);

fun set_progress(fraction) {
    if (fraction < 0.02) fraction = 0.02;
    if (fraction > 1) fraction = 1;
    width = Math.Int(bar.original.GetWidth() * fraction);
    if (width < 1) width = 1;
    bar.sprite.SetImage(bar.original.Crop(0, 0, width, bar.original.GetHeight()));
}
set_progress(0);

fun boot_progress_callback(duration, progress) {
    if (Plymouth.GetMode() == "boot")
        set_progress(progress);
}
Plymouth.SetBootProgressFunction(boot_progress_callback);

# Shutdown and reboot have no meaningful progress: gently pulse the logo.
tick = 0;
fun refresh_callback() {
    tick++;
    if (Plymouth.GetMode() != "boot") {
        track.sprite.SetOpacity(0);
        bar.sprite.SetOpacity(0);
        logo.sprite.SetOpacity(0.65 + 0.35 * Math.Sin(tick / 25));
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---- messages -----------------------------------------------------------------
message.sprite = Sprite();
fun show_message(text) {
    message.image = Image.Text(text, 0.58, 0.64, 0.72, 1, "Sans 11");
    message.sprite.SetImage(message.image);
    message.sprite.SetPosition(center_x - message.image.GetWidth() / 2, track.y + 150, 10);
}
fun display_message_callback(text) { show_message(text); }
fun hide_message_callback(text) { message.sprite.SetImage(Image.Text("", 0, 0, 0)); }
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
Plymouth.SetMessageFunction(display_message_callback);

# ---- passphrase prompt --------------------------------------------------------
entry.image = Image("entry.png");
entry.sprite = Sprite(entry.image);
entry.x = center_x - entry.image.GetWidth() / 2;
entry.y = track.y + 40;
entry.sprite.SetPosition(entry.x, entry.y, 20);
entry.sprite.SetOpacity(0);
prompt.sprite = Sprite();
bullet.image = Image("bullet.png");
bullets = [];
bullet_count = 0;

fun hide_prompt() {
    entry.sprite.SetOpacity(0);
    prompt.sprite.SetOpacity(0);
    for (i = 0; i < bullet_count; i++)
        bullets[i].SetOpacity(0);
}

fun display_password_callback(text, count) {
    track.sprite.SetOpacity(0);
    bar.sprite.SetOpacity(0);
    entry.sprite.SetOpacity(1);
    prompt.image = Image.Text(text, 0.90, 0.91, 0.92, 1, "Sans 12");
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetPosition(center_x - prompt.image.GetWidth() / 2, entry.y - 32, 20);
    prompt.sprite.SetOpacity(1);
    # At most as many bullets as fit into the box; the count itself is not a secret
    # the box needs to reveal beyond that.
    max = Math.Int((entry.image.GetWidth() - 28) / 18);
    shown = count;
    if (shown > max) shown = max;
    for (i = bullet_count; i < shown; i++) {
        bullets[i] = Sprite(bullet.image);
        bullets[i].SetPosition(entry.x + 16 + i * 18, entry.y + entry.image.GetHeight() / 2 - 6, 21);
    }
    if (shown > bullet_count) bullet_count = shown;
    for (i = 0; i < bullet_count; i++) {
        if (i < shown) bullets[i].SetOpacity(1);
        else bullets[i].SetOpacity(0);
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    hide_prompt();
    if (Plymouth.GetMode() == "boot") {
        track.sprite.SetOpacity(1);
        bar.sprite.SetOpacity(1);
    }
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun display_question_callback(text, entry_text) {
    show_message(text + " " + entry_text);
}
Plymouth.SetDisplayQuestionFunction(display_question_callback);

fun quit_callback() {
    logo.sprite.SetOpacity(1);
}
Plymouth.SetQuitFunction(quit_callback);
