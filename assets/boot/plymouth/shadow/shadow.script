# Shadow OS boot splash (Plymouth "script" module).
#
# A glowing logo over a pulsing cyan halo, a cyan spinner ring and a slower
# violet inner arc, and a progress bar with a soft glow. It also asks for the
# disk-encryption passphrase and shows boot messages. Escape switches to the
# text log as usual; the splash never hides diagnostics that were asked for.

Window.SetBackgroundTopColor(0.016, 0.022, 0.043);
Window.SetBackgroundBottomColor(0.008, 0.012, 0.025);

cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

fun centered(image, z) {
    s = Sprite(image);
    s.SetX(cx - image.GetWidth() / 2);
    s.SetY(cy - image.GetHeight() / 2 - 40);
    s.SetZ(z);
    return s;
}

# ---- halo, rings, logo --------------------------------------------------------
glow.image  = Image("glow.png");
glow.sprite = centered(glow.image, 5);

ring.image  = Image("ring.png");
ring.sprite = centered(ring.image, 8);

ring2.image  = Image("ring2.png");
ring2.sprite = centered(ring2.image, 9);

logo.image  = Image("logo.png");
logo.sprite = centered(logo.image, 12);

# ---- progress -----------------------------------------------------------------
track.image = Image("track.png");
track.x = cx - track.image.GetWidth() / 2;
track.y = cy + 92;
track.sprite = Sprite(track.image);
track.sprite.SetPosition(track.x, track.y, 10);

bar.full  = Image("bar.png");
glowbar.full = Image("barglow.png");
bar.sprite = Sprite();
glowbar.sprite = Sprite();

fun set_progress(fraction) {
    if (fraction < 0.015) fraction = 0.015;
    if (fraction > 1) fraction = 1;
    w = Math.Int(bar.full.GetWidth() * fraction);
    if (w < 1) w = 1;
    bar.sprite.SetImage(bar.full.Crop(0, 0, w, bar.full.GetHeight()));
    bar.sprite.SetPosition(track.x, track.y, 11);
    gw = Math.Int(glowbar.full.GetWidth() * fraction);
    if (gw < 1) gw = 1;
    glowbar.sprite.SetImage(glowbar.full.Crop(0, 0, gw, glowbar.full.GetHeight()));
    glowbar.sprite.SetPosition(track.x, track.y - 1, 10);
}
set_progress(0);

fun boot_progress_cb(duration, progress) {
    if (Plymouth.GetMode() == "boot") set_progress(progress);
}
Plymouth.SetBootProgressFunction(boot_progress_cb);

# ---- wordmark -----------------------------------------------------------------
title.image = Image.Text("SHADOW OS", 0.90, 0.95, 1.0, 1, "Sans 14");
title.sprite = Sprite(title.image);
title.sprite.SetPosition(cx - title.image.GetWidth() / 2, cy + 46, 12);

# ---- animation ----------------------------------------------------------------
tick = 0;
fun refresh_cb() {
    tick++;
    # Spin the rings in opposite directions (radians).
    ring.sprite.SetImage(ring.image.Rotate(tick * 0.06));
    ring.sprite.SetX(cx - ring.image.GetWidth() / 2);
    ring.sprite.SetY(cy - ring.image.GetHeight() / 2 - 40);
    ring2.sprite.SetImage(ring2.image.Rotate(-tick * 0.035));
    ring2.sprite.SetX(cx - ring2.image.GetWidth() / 2);
    ring2.sprite.SetY(cy - ring2.image.GetHeight() / 2 - 40);
    # Pulse the halo.
    glow.sprite.SetOpacity(0.55 + 0.30 * Math.Sin(tick / 16));

    if (Plymouth.GetMode() != "boot") {
        # Shutdown / reboot: no progress, gently breathe the logo.
        track.sprite.SetOpacity(0);
        bar.sprite.SetOpacity(0);
        glowbar.sprite.SetOpacity(0);
        logo.sprite.SetOpacity(0.7 + 0.3 * Math.Sin(tick / 18));
    }
}
Plymouth.SetRefreshFunction(refresh_cb);

# ---- boot messages ------------------------------------------------------------
message.sprite = Sprite();
fun show_message(text) {
    message.image = Image.Text(text, 0.58, 0.64, 0.72, 1, "Sans 10");
    message.sprite.SetImage(message.image);
    message.sprite.SetPosition(cx - message.image.GetWidth() / 2, track.y + 150, 10);
}
fun clear_message() { message.sprite.SetImage(Image.Text("", 0, 0, 0)); }
Plymouth.SetDisplayMessageFunction(fun (t) { show_message(t); });
Plymouth.SetHideMessageFunction(fun (t) { clear_message(); });
Plymouth.SetMessageFunction(fun (t) { show_message(t); });

# ---- passphrase prompt --------------------------------------------------------
entry.image = Image("entry.png");
entry.sprite = Sprite(entry.image);
entry.x = cx - entry.image.GetWidth() / 2;
entry.y = track.y + 44;
entry.sprite.SetPosition(entry.x, entry.y, 20);
entry.sprite.SetOpacity(0);
prompt.sprite = Sprite();
bullet.image = Image("bullet.png");
bullets = [];
bullet_count = 0;

fun hide_prompt() {
    entry.sprite.SetOpacity(0);
    prompt.sprite.SetOpacity(0);
    for (i = 0; i < bullet_count; i++) bullets[i].SetOpacity(0);
}

fun display_password_cb(prompt_text, count) {
    track.sprite.SetOpacity(0);
    bar.sprite.SetOpacity(0);
    glowbar.sprite.SetOpacity(0);
    entry.sprite.SetOpacity(1);
    prompt.image = Image.Text(prompt_text, 0.90, 0.91, 0.92, 1, "Sans 11");
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetPosition(cx - prompt.image.GetWidth() / 2, entry.y - 30, 20);
    prompt.sprite.SetOpacity(1);
    max = Math.Int((entry.image.GetWidth() - 28) / 18);
    shown = count;
    if (shown > max) shown = max;
    for (i = bullet_count; i < shown; i++) {
        bullets[i] = Sprite(bullet.image);
        bullets[i].SetPosition(entry.x + 16 + i * 18, entry.y + entry.image.GetHeight() / 2 - 6, 21);
    }
    if (shown > bullet_count) bullet_count = shown;
    for (i = 0; i < bullet_count; i++) {
        if (i < shown) bullets[i].SetOpacity(1);
        else bullets[i].SetOpacity(0);
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_cb);

fun display_normal_cb() {
    hide_prompt();
    if (Plymouth.GetMode() == "boot") {
        track.sprite.SetOpacity(1);
        bar.sprite.SetOpacity(1);
        glowbar.sprite.SetOpacity(1);
    }
}
Plymouth.SetDisplayNormalFunction(display_normal_cb);

Plymouth.SetDisplayQuestionFunction(fun (prompt_text, entry_text) {
    show_message(prompt_text + " " + entry_text);
});
Plymouth.SetQuitFunction(fun () { logo.sprite.SetOpacity(1); });
