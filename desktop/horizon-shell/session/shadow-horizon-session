#!/bin/sh
# shadow-horizon-session — start the Shadow Horizon desktop.
#
# Run by the display manager for the "Shadow Horizon" session
# (/usr/share/wayland-sessions/shadow-horizon.desktop). It sets the session
# environment and starts the compositor, which in turn starts the session
# supervisor (horizon-session-leader) once it accepts clients; when the
# supervisor exits, the compositor exits and the session is over.
#
# Compositor: KWin in Wayland mode. Shadow Horizon uses KWin as its compositor
# and window manager; the shell, session and settings on top are SHADOW's own
# (docs/desktop/architecture.md).

# Desktop identity. "SHADOW" comes first; "KDE" lets software that only knows
# the established desktops (portal back-ends, KDE Frameworks applications,
# xdg-utils) pick its KDE behaviour.
export XDG_CURRENT_DESKTOP="SHADOW:KDE"
export XDG_SESSION_DESKTOP="shadow"
export XDG_SESSION_TYPE="wayland"
export XDG_MENU_PREFIX="shadow-"
export KDE_FULL_SESSION="true"
export KDE_SESSION_VERSION="6"

# Toolkits: native Wayland first, X11 (through Xwayland) as fallback.
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME="kde"
export GDK_BACKEND="wayland,x11"
export SDL_VIDEODRIVER="wayland,x11"
export CLUTTER_BACKEND="wayland"
export MOZ_ENABLE_WAYLAND="1"
export ELECTRON_OZONE_PLATFORM_HINT="auto"
# Java (Swing/AWT) tools such as Burp Suite and Ghidra run through Xwayland
# and need this to lay out correctly under a non-reparenting window manager.
export _JAVA_AWT_WM_NONREPARENTING="1"

# Pointer theme and size: the user's saved choice (Control Center writes
# kcminputrc), else the SHADOW defaults. The compositor prefers these
# variables over its configuration, so they must carry the saved values.
cursor_theme=""; cursor_size=""
if command -v kreadconfig6 >/dev/null 2>&1; then
    cursor_theme="$(kreadconfig6 --file kcminputrc --group Mouse --key cursorTheme 2>/dev/null)"
    cursor_size="$(kreadconfig6 --file kcminputrc --group Mouse --key cursorSize 2>/dev/null)"
fi
case "$cursor_size" in ''|*[!0-9]*) cursor_size="" ;; esac
export XCURSOR_THEME="${cursor_theme:-${XCURSOR_THEME:-breeze_cursors}}"
export XCURSOR_SIZE="${cursor_size:-${XCURSOR_SIZE:-24}}"

# A place for per-session state of SHADOW components.
if [ -n "$XDG_RUNTIME_DIR" ]; then
    mkdir -p "$XDG_RUNTIME_DIR/shadow"
fi

# Lock screen: KScreenLocker takes its QML from this shell package
# (also set in /etc/xdg/plasmashellrc).
export PLASMA_DEFAULT_SHELL="org.shadow.horizon"

# No GPU render node means there is no hardware 3D (a basic virtual machine,
# a display adapter without a driver). Software OpenGL is slow there and has
# been seen to crash the compositor, so composite and draw applications with
# the CPU renderers instead. SHADOW_SOFTWARE_RENDERING=0/1 overrides the test.
software="${SHADOW_SOFTWARE_RENDERING:-auto}"
if [ "$software" = "auto" ]; then
    software=1
    for node in /dev/dri/renderD*; do
        [ -e "$node" ] && software=0
    done
fi
if [ "$software" = "1" ]; then
    export KWIN_COMPOSE="Q"
    export QT_QUICK_BACKEND="software"
    # Belt and braces for virtual machines: force the whole GL stack onto the
    # CPU (llvmpipe) and KWin's OpenGL path off, so a missing/buggy virtual GPU
    # driver cannot crash the compositor and drop the session to the greeter.
    export LIBGL_ALWAYS_SOFTWARE="1"
    export GALLIUM_DRIVER="llvmpipe"
    export KWIN_OPENGL_INTERFACE="egl"
    export __GLX_VENDOR_LIBRARY_NAME="mesa"
fi

# Third-party Qt/KDE and GTK applications follow the saved SHADOW appearance.
if command -v shadow-apply-appearance >/dev/null 2>&1; then
    shadow-apply-appearance >/dev/null 2>&1 || true
fi

exec kwin_wayland_wrapper --xwayland \
    --exit-with-session=/usr/libexec/shadow/horizon-session-leader
