{
  "meta": {
    "name": "SHADOW design tokens",
    "version": "1",
    "description": "Single source of truth for the Shadow Horizon visual language. Everything visual (QML Theme singleton, Qt Quick Controls style, widget style sheets, KDE colour schemes, boot/login themes, documentation) is generated from this file by scripts/gen-tokens.py. Never hard-code a colour, size or duration in a component."
  },

  "color": {
    "dark": {
      "bgBase":        "#06080C",
      "bgSurface":     "#0B0F16",
      "bgRaised":      "#111722",
      "bgOverlay":     "#161D2B",
      "bgInput":       "#0D121B",
      "bgHover":       "#1A2233",
      "bgPressed":     "#202A3F",
      "borderSubtle":  "#1A2130",
      "border":        "#242D40",
      "borderStrong":  "#33405A",
      "textPrimary":   "#E9EEF8",
      "textSecondary": "#A3B0C6",
      "textMuted":     "#6B7892",
      "textDisabled":  "#465068",
      "textOnAccent":  "#03131A",
      "success":       "#2EE6A6",
      "warning":       "#FFC23D",
      "danger":        "#FF4D6A",
      "shadow":        "#000000",
      "scrim":         "#B3000000"
    },
    "light": {
      "bgBase":        "#F3F5F9",
      "bgSurface":     "#EBEEF4",
      "bgRaised":      "#FFFFFF",
      "bgOverlay":     "#FFFFFF",
      "bgInput":       "#FFFFFF",
      "bgHover":       "#E4E9F1",
      "bgPressed":     "#D8DFEA",
      "borderSubtle":  "#E1E6EE",
      "border":        "#CFD6E2",
      "borderStrong":  "#AEB8C9",
      "textPrimary":   "#0A1020",
      "textSecondary": "#45526A",
      "textMuted":     "#6E7A91",
      "textDisabled":  "#A5AFC0",
      "textOnAccent":  "#FFFFFF",
      "success":       "#0E9F6E",
      "warning":       "#B7791F",
      "danger":        "#D92D4A",
      "shadow":        "#1A2233",
      "scrim":         "#660A1020"
    }
  },

  "accent": {
    "cyan":    { "label": "Neon Cyan",     "dark": "#22D8F5", "light": "#067C99" },
    "blue":    { "label": "Electric Blue", "dark": "#3D8BFF", "light": "#1D5FE0" },
    "violet":  { "label": "Violet",        "dark": "#9B6BFF", "light": "#6D3FE0" },
    "emerald": { "label": "Emerald",       "dark": "#2EE6A6", "light": "#087F58" },
    "amber":   { "label": "Amber",         "dark": "#FFB020", "light": "#9A5F06" },
    "rose":    { "label": "Rose",          "dark": "#FF5C8A", "light": "#D42A5C" }
  },
  "accentDefault": "cyan",

  "brand": {
    "gradientStart": "#22D8F5",
    "gradientMid":   "#3D8BFF",
    "gradientEnd":   "#9B6BFF",
    "obsidian":      "#06080C"
  },

  "font": {
    "ui":      "Inter Variable",
    "uiFallback": "Inter, Noto Sans, sans-serif",
    "mono":    "JetBrains Mono",
    "monoFallback": "Noto Sans Mono, monospace"
  },

  "fontSize": {
    "caption": 11,
    "small":   12,
    "body":    13,
    "bodyLarge": 14,
    "title":   16,
    "heading": 20,
    "display": 28,
    "hero":    40
  },

  "fontWeight": {
    "regular": 400,
    "medium":  500,
    "semibold": 600,
    "bold":    700
  },

  "space": {
    "xxs": 2,
    "xs":  4,
    "sm":  8,
    "md":  12,
    "lg":  16,
    "xl":  24,
    "xxl": 32,
    "xxxl": 48
  },

  "radius": {
    "xs":  4,
    "sm":  6,
    "md":  10,
    "lg":  14,
    "xl":  20,
    "pill": 999
  },

  "size": {
    "iconSmall": 16,
    "icon":      20,
    "iconLarge": 24,
    "iconXL":    32,
    "controlHeight":      34,
    "controlHeightLarge": 40,
    "rowHeight":     44,
    "rowHeightLarge": 56,
    "headerHeight":  52,
    "sidebarWidth":  248,
    "panelHeight":   34,
    "dockIcon":      48,
    "borderWidth":   1,
    "focusRing":     2,
    "windowDefaultWidth":  1120,
    "windowDefaultHeight": 720,
    "windowMinWidth":  720,
    "windowMinHeight": 480
  },

  "motion": {
    "instant": 80,
    "fast":    140,
    "normal":  220,
    "slow":    340,
    "page":    460
  },

  "easing": {
    "standard":   [0.2, 0.0, 0.0, 1.0],
    "decelerate": [0.05, 0.7, 0.1, 1.0],
    "accelerate": [0.3, 0.0, 0.8, 0.15]
  },

  "elevation": {
    "level1": { "y": 1,  "blur": 3,  "opacity": 0.35 },
    "level2": { "y": 8,  "blur": 24, "opacity": 0.45 },
    "level3": { "y": 24, "blur": 64, "opacity": 0.55 },
    "glow":   { "y": 0,  "blur": 28, "opacity": 0.35 }
  },

  "opacity": {
    "disabled": 0.42,
    "glassPanel": 0.72,
    "glassPopup": 0.86,
    "hoverOverlay": 0.06,
    "pressedOverlay": 0.12,
    "selectedFill": 0.16
  }
}
