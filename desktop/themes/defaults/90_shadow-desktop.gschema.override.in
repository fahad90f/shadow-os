# @@GENERATED@@
#
# GSettings defaults (/usr/share/glib-2.0/schemas/, compiled by the
# libglib2.0-0 dpkg trigger). GTK 3/4 applications on Wayland read
# org.gnome.desktop.interface through GSettings or the GTK portal back-end
# rather than settings.ini; color-scheme here is also what
# xdg-desktop-portal-gtk reports as org.freedesktop.appearance color-scheme
# when it, and not the KDE back-end, answers.
[org.gnome.desktop.interface]
color-scheme='prefer-dark'
gtk-theme='Adwaita-dark'
icon-theme='shadow'
cursor-theme='breeze_cursors'
cursor-size=24
font-name='@{font.ui} 10'
document-font-name='@{font.ui} 10'
monospace-font-name='@{font.mono} 10'

[org.gnome.desktop.wm.preferences]
button-layout=':minimize,maximize,close'
titlebar-font='@{font.ui} Semi-Bold 10'
