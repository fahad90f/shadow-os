# @@GENERATED@@
#
# System defaults for GTK 4 applications in a NEXUS HORIZON session
# (/etc/xdg/gtk-4.0/settings.ini; ~/.config/gtk-4.0/settings.ini overrides).
# gtk-application-prefer-dark-theme is honoured by plain GTK 4 applications
# only. libadwaita applications ignore it: they follow the "color-scheme"
# key of org.freedesktop.appearance on the settings portal (see README.md).
[Settings]
gtk-application-prefer-dark-theme=true
gtk-icon-theme-name=nexus
gtk-cursor-theme-name=breeze_cursors
gtk-cursor-theme-size=24
gtk-font-name=@{font.ui} 10
gtk-decoration-layout=:minimize,maximize,close
gtk-enable-animations=true
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintslight
gtk-xft-rgba=rgb
