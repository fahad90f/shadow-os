#
# SHADOW icon theme, dark variant ("shadow").
#
# SHADOW draws its own places (folder) icons; every other icon comes from the
# inherited themes: breeze-dark for actions, devices, file types and status,
# and hicolor, where applications install their own icons — including the
# SHADOW applications (hicolor/scalable/apps/org.shadow.*.svg) and the arsenal
# category icons (hicolor/scalable/categories/shadow-*.svg), so they are found
# under every icon theme and by every toolkit.
[Icon Theme]
Name=SHADOW
Comment=Shadow OS icons for the dark appearance
Inherits=breeze-dark,hicolor
Example=folder
DisplayDepth=32

# KDE: recolour monochrome icons (also the inherited ones) with the colours
# of the active colour scheme.
FollowsColorScheme=true

# KDE icon sizes per use, the values the inherited theme is drawn for.
DesktopDefault=48
DesktopSizes=16,22,32,48,64,128,256
ToolbarDefault=22
ToolbarSizes=16,22,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,32,48
SmallDefault=16
SmallSizes=16,22,32,48
PanelDefault=48
PanelSizes=16,22,32,48,64,128,256
DialogDefault=32
DialogSizes=16,22,32,48,64,128,256

KDE-Extensions=.svg

Directories=16/places,64/places

# Folders without a glyph, for small sizes.
[16/places]
Size=16
MinSize=16
MaxSize=31
Context=Places
Type=Scalable

# Folders with a glyph, for 32 px and larger.
[64/places]
Size=64
MinSize=32
MaxSize=512
Context=Places
Type=Scalable
