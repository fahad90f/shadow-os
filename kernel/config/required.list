# Options that MUST be present with exactly this value in the final .config.
# The build fails otherwise. One per line: CONFIG_NAME=value, or
# "CONFIG_NAME is not set". Lines may be limited to an architecture with a
# trailing [amd64] / [arm64].

CONFIG_HZ=1000
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_LEGACY_TIOCSTI is not set
CONFIG_LDISC_AUTOLOAD is not set
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_AUDIT=y
CONFIG_SECCOMP_FILTER=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_FORCE is not set
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
CONFIG_LEGACY_VSYSCALL_NONE=y [amd64]
CONFIG_X86_KERNEL_IBT=y [amd64]
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y [amd64]
CONFIG_MITIGATION_RETPOLINE=y [amd64]
CONFIG_MITIGATION_SLS=y [amd64]
CONFIG_INTEL_IOMMU=y [amd64]
CONFIG_ARM64_PTR_AUTH_KERNEL=y [arm64]
CONFIG_ARM64_BTI_KERNEL=y [arm64]
CONFIG_ARM64_MTE=y [arm64]
CONFIG_UNMAP_KERNEL_AT_EL0=y [arm64]

# Things a distribution kernel must not lose (boot, live medium, encryption,
# containers, virtualisation). These come from Debian's configuration; they
# are listed so that a mistake in a fragment is caught here, not at boot.
CONFIG_MODULES=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_SQUASHFS=m
CONFIG_OVERLAY_FS=m
CONFIG_DM_CRYPT=m
CONFIG_EXT4_FS=m
CONFIG_VFAT_FS=m
CONFIG_NF_TABLES=m
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_KVM=m
CONFIG_DRM=m
CONFIG_SND=m
CONFIG_WLAN=y
CONFIG_BT=m
CONFIG_USB_STORAGE=m
CONFIG_NVME_CORE=m
CONFIG_VIRTIO_BLK=m
