# Options that MUST be present with exactly this value in the final .config.
# The build fails otherwise. One per line: CONFIG_NAME=value, or
# "CONFIG_NAME is not set". Lines may be limited to an architecture with a
# trailing [amd64] / [arm64].

CONFIG_HZ=1000
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_LEGACY_TIOCSTI is not set
CONFIG_LDISC_AUTOLOAD is not set
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_AUDIT=y
CONFIG_SECCOMP_FILTER=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_FORCE is not set
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
CONFIG_LEGACY_VSYSCALL_NONE=y [amd64]
CONFIG_X86_KERNEL_IBT=y [amd64]
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y [amd64]
CONFIG_MITIGATION_RETPOLINE=y [amd64]
CONFIG_MITIGATION_SLS=y [amd64]
CONFIG_INTEL_IOMMU=y [amd64]
CONFIG_ARM64_PTR_AUTH_KERNEL=y [arm64]
# CONFIG_ARM64_BTI_KERNEL is not required: Linux 6.12 allows it only when the
# kernel is built with clang ("depends on !CC_IS_GCC", GCC bug 106671), and
# Debian's kernel is built with GCC. Pointer authentication (above) and BTI
# for user space (CONFIG_ARM64_BTI) still apply.
CONFIG_ARM64_BTI=y [arm64]
CONFIG_ARM64_MTE=y [arm64]
CONFIG_UNMAP_KERNEL_AT_EL0=y [arm64]

# Things a distribution kernel must not lose (boot, live medium, encryption,
# containers, virtualisation). These come from Debian's configuration; they
# are listed so that a mistake in a fragment is caught here, not at boot.
CONFIG_MODULES=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_SQUASHFS=m
CONFIG_OVERLAY_FS=m
CONFIG_DM_CRYPT=m
CONFIG_EXT4_FS=m
CONFIG_VFAT_FS=m
CONFIG_NF_TABLES=m
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_KVM=m [amd64]
# On arm64 KVM cannot be a module.
CONFIG_KVM=y [arm64]
CONFIG_DRM=m
CONFIG_SND=m
CONFIG_WLAN=y
CONFIG_BT=m
CONFIG_USB_STORAGE=m
CONFIG_NVME_CORE=m
CONFIG_VIRTIO_BLK=m

# The kill switch, panic and Hide Me (security/firewall/shadow-killswitch,
# security/firewall/shadow-panic, distro/base/rootfs/usr/bin/shadow-anon;
# docs/security/kill-switch.md). Without them a mode cannot load (the tools
# then report "not loaded") or existing connections are not cut.
# "table inet": one table for IPv4 and IPv6 (selects NF_TABLES_IPV4/IPV6).
CONFIG_NF_TABLES_INET=y
# "ct state established,related" (replies from a VPN tunnel to a forwarded VM).
CONFIG_NFT_CT=m
CONFIG_NF_CONNTRACK=m
# "conntrack -F" when a mode is engaged or a panic starts (ctnetlink).
CONFIG_NF_CT_NETLINK=m
# "ss -K": closing the sockets a stricter mode or a panic blocks.
CONFIG_INET_DIAG=m
CONFIG_INET_TCP_DIAG=m
CONFIG_INET_UDP_DIAG=m
CONFIG_INET_DIAG_DESTROY=y
# The bridge tables of the kill switch and the panic: frames a bridge forwards
# (virtual machines, containers bridged to the network card) never reach the
# inet hooks without br_netfilter. Without it the tools load the inet table
# alone and warn that bridged guests are not covered.
CONFIG_NF_TABLES_BRIDGE=m
# The tunnels the "vpn" mode lets out (OpenVPN's tun devices, WireGuard).
CONFIG_TUN=m
CONFIG_WIREGUARD=m
# The panic soft-blocks radios through /sys/class/rfkill.
CONFIG_RFKILL=m
# Hide Me's transparent Tor proxy and DNS redirect are iptables-nft nat rules.
# iptables-nft loads "-m owner" and "-j REDIRECT" as xt compat expressions
# ([match owner], [target REDIRECT]; checked with iptables 1.8.10), not as
# nft's native redirect (CONFIG_NFT_REDIR, which nothing here uses).
CONFIG_NFT_COMPAT=m
CONFIG_NFT_NAT=m
CONFIG_NF_NAT=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m

# The per-application firewall (security/firewall/shadow-appfw;
# docs/security/app-firewall.md): its one rule matches the control group a
# socket was created in ("socket cgroupv2 level 1 @blocked"), and rejects with
# a TCP reset or an ICMP error. Without NFT_SOCKET the rule cannot be loaded
# and a blocked application is not started at all (shadow-appfw-run).
CONFIG_NFT_SOCKET=m
CONFIG_SOCK_CGROUP_DATA=y
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
