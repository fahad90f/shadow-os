# SHADOW kernel configuration fragment — all architectures.
#
# The SHADOW kernel is Debian's kernel source for the stable series, built with
# Debian's own configuration for the architecture (so hardware support is the
# same as Debian's) plus the options below. Each group says why it is here;
# docs/kernel/configuration.md has the long form, including what Debian
# already enables and is merely pinned here so a future rebase cannot lose it.
#
# Merged with scripts/kconfig/merge_config.sh; kernel/config/required.list is
# then checked against the final .config and the build fails if any required
# option did not take effect.

# ---- identity -----------------------------------------------------------------
CONFIG_DEFAULT_HOSTNAME="shadow"

# ---- desktop responsiveness ----------------------------------------------------
# 1000 Hz tick and full preemption by default (still switchable at boot with
# preempt=voluntary thanks to PREEMPT_DYNAMIC): lower input and audio latency
# on an interactive workstation, at a small throughput cost.
# CONFIG_HZ_250 is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000
# CONFIG_PREEMPT_VOLUNTARY is not set
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_SCHED_AUTOGROUP=y

# ---- memory-safety hardening ------------------------------------------------------
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
# Clear caller-saved registers on function return: fewer usable ROP gadgets.
CONFIG_ZERO_CALL_USED_REGS=y
# Treat detected corruption of kernel lists and other core structures as fatal
# for the offending task instead of continuing on corrupted state.
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
# Array-bounds checks compiled into the kernel; violations are reported, not fatal.
CONFIG_UBSAN=y
CONFIG_UBSAN_BOUNDS=y
# CONFIG_UBSAN_TRAP is not set
# CONFIG_UBSAN_SHIFT is not set
# CONFIG_UBSAN_BOOL is not set
# CONFIG_UBSAN_ENUM is not set

# ---- reducing what unprivileged code can reach -----------------------------------
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_BPF_JIT_ALWAYS_ON=y
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_LDISC_AUTOLOAD is not set
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y

# ---- security modules --------------------------------------------------------------
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ---- kernel modules -------------------------------------------------------------------
# Every in-tree module is signed with a key generated for the build and then
# discarded, so no additional module can ever carry a valid signature.
# Signatures are not *enforced* by default (that would block DKMS drivers such
# as the proprietary NVIDIA module); under Secure Boot the kernel's lockdown
# enforces them.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_HASH="sha512"
# CONFIG_MODULE_SIG_FORCE is not set

# ---- DMA protection -------------------------------------------------------------------------
# Strict IOMMU TLB invalidation closes the window in which a device can still
# reach memory that was just unmapped. Costs some throughput on very fast
# storage/network devices; iommu.strict=0 on the kernel command line reverts it.
# CONFIG_IOMMU_DEFAULT_DMA_LAZY is not set
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
