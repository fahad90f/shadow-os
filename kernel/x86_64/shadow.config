# SHADOW kernel configuration fragment — amd64 (x86_64).

# Remove the legacy vsyscall page entirely (only decades-old static binaries use it).
# CONFIG_LEGACY_VSYSCALL_XONLY is not set
CONFIG_LEGACY_VSYSCALL_NONE=y

# Control-flow integrity support in hardware.
CONFIG_X86_KERNEL_IBT=y
CONFIG_X86_USER_SHADOW_STACK=y

# Speculative execution mitigations: pin Debian's defaults and add the
# straight-line-speculation mitigation.
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_MITIGATION_SLS=y

# Keep 32-bit compatibility (Wine, Steam, legacy tools) but not the legacy
# fixed-address compat vDSO.
CONFIG_IA32_EMULATION=y
# CONFIG_COMPAT_VDSO is not set

# IOMMU support (DMA protection, device passthrough for lab VMs). Whether the
# Intel IOMMU is active by default is left exactly as Debian has it: on, except
# for integrated graphics, which Debian excludes because of long-standing
# firmware and driver quirks on some laptops. "intel_iommu=on" forces it on.
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y
