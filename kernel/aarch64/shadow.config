# SHADOW kernel configuration fragment — arm64 (AArch64).

# Pointer authentication and branch target identification for the kernel
# itself (used when the CPU implements ARMv8.3-PAuth / ARMv8.5-BTI).
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_PTR_AUTH_KERNEL=y
CONFIG_ARM64_BTI=y
# CONFIG_ARM64_BTI_KERNEL needs a clang-built kernel in 6.12 (GCC bug 106671);
# it is requested anyway so that a clang build enables it.
CONFIG_ARM64_BTI_KERNEL=y
# Memory tagging for user space, and privileged-access-never emulation for
# CPUs without the PAN feature.
CONFIG_ARM64_MTE=y
CONFIG_ARM64_SW_TTBR0_PAN=y
# Kernel page-table isolation where the CPU needs it.
CONFIG_UNMAP_KERNEL_AT_EL0=y
CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY=y
CONFIG_ARM_SMMU_V3=y
