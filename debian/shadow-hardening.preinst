#!/bin/sh
# The nftables package ships an (empty, allow-everything) /etc/nftables.conf.
# Shadow OS replaces it with a default-deny ruleset; the Debian file is kept
# as /etc/nftables.conf.debian through a diversion.
set -e

case "$1" in
    install|upgrade)
        if ! dpkg-divert --list /etc/nftables.conf | grep -q "by shadow-hardening"; then
            dpkg-divert --package shadow-hardening --add --rename \
                --divert /etc/nftables.conf.debian /etc/nftables.conf
        fi
        ;;
esac

#DEBHELPER#
exit 0
