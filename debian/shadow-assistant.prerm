#!/bin/sh
set -e
# The voice engine writes no Python byte code (shadow-voiced runs with -I -B),
# but earlier versions did when run as root (the self-test of
# "shadow-voice-setup --system"). Such byte code belongs to no package: remove
# it before dpkg removes or replaces the modules, so their directory does not
# stay behind.
case "$1" in
    remove|upgrade|deconfigure|failed-upgrade)
        rm -rf /usr/lib/shadow-assistant/voice/shadow_voice/__pycache__
        ;;
esac
#DEBHELPER#
exit 0
