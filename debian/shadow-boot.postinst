#!/bin/sh
set -e

STATE_DIR=/var/lib/shadow
FAILED_FLAG="$STATE_DIR/boot-loader-refresh-failed"

refresh() {
    # Only installed systems carry /etc/shadow-os/boot.conf; in the live session
    # and in build chroots this is a no-op.
    [ -f /etc/shadow-os/boot.conf ] || return 0
    mkdir -p "$STATE_DIR"
    if shadow-grub-install; then
        rm -f "$FAILED_FLAG"
    else
        # Do not fail the package run (that would leave apt half-configured),
        # but leave a durable marker that the Updater and Security Center report.
        date -u +%Y-%m-%dT%H:%M:%SZ > "$FAILED_FLAG"
        echo "shadow-boot: WARNING: the boot loader could not be refreshed." >&2
        echo "shadow-boot: run 'sudo shadow-grub-install --verbose' and check the output." >&2
    fi
}

case "$1" in
    triggered)
        refresh
        ;;
    configure)
        # On upgrade of this package itself, apply any change in how it installs.
        if [ -n "$2" ]; then
            refresh
        fi
        ;;
esac

#DEBHELPER#
exit 0
