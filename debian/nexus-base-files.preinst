#!/bin/sh
# Take over the identity files that Debian's base-files package ships. They
# are diverted (not replaced), so base-files keeps upgrading cleanly and the
# Debian originals stay available as *.debian.
set -e

divert() {
    file="$1"
    if ! dpkg-divert --list "$file" | grep -q "by nexus-base-files"; then
        dpkg-divert --package nexus-base-files --add --rename --divert "$file.debian" "$file"
    fi
}

case "$1" in
    install|upgrade)
        divert /usr/lib/os-release
        divert /etc/issue
        divert /etc/issue.net
        ;;
esac

#DEBHELPER#
exit 0
