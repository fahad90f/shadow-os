#!/usr/bin/make -f
# Shadow OS packaging. One source package builds every SHADOW component:
#   dpkg-buildpackage -A   → architecture-independent packages (no compiler run)
#   dpkg-buildpackage -B   → compiled packages for the build architecture
#   dpkg-buildpackage -b   → both
# Normally invoked through build/packages/build.sh inside the build chroot.

include /usr/share/dpkg/architecture.mk

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export QT_QPA_PLATFORM = offscreen

GEN := debian/generated

%:
	dh $@ --buildsystem=cmake+ninja

# Every package built from CMake corresponds to one CMake install component
# of the same name (see the top-level CMakeLists.txt).
ARCH_PACKAGES := $(shell dh_listpackages -a)
DATA_PACKAGES := shadow-artwork shadow-themes
DATA_BUILD := obj-data

define install_components
	set -e; for package in $(1); do \
	    if ! grep -q "^Package: $$package$$" debian/control; then continue; fi; \
	    case $$package in shadow-arsenal-*) continue ;; esac; \
	    DESTDIR=$(CURDIR)/debian/$$package cmake --install $(2) --component $$package; \
	    if [ -z "$$(find debian/$$package -type f -print -quit 2>/dev/null)" ]; then \
	        echo "error: CMake install component '$$package' installed no files" >&2; exit 1; \
	    fi; \
	done
endef

# ---- compiled components (CMake) — architecture-dependent builds only -------
override_dh_auto_configure-arch:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=RelWithDebInfo

override_dh_auto_install-arch:
	$(call install_components,$(ARCH_PACKAGES),obj-$(DEB_HOST_GNU_TYPE))

override_dh_auto_test-arch:
	@echo "GUI smoke tests run from tests/desktop/smoke.sh, not during package build"

# shadow-offline-update.service installs prepared updates and restarts the
# computer: it must only ever run in an update boot, never be started by the
# package. Upgrading the Updater from inside that boot would otherwise make the
# service wait for itself.
override_dh_installsystemd-arch:
	dh_installsystemd -a -Nshadow-updater
	dh_installsystemd -pshadow-updater --no-start

# The Hide Me rotation timer (shadow-hardening) asks Tor for new circuits
# (at most once a minute, never a new MAC address): only the user turns it on
# (shadow-anon start).
# shadow-anon-boot.service is enabled and also run on install and upgrade: it
# puts back DNS-over-Tor's redirect (a system that restarted with DNS
# protection on has no working DNS until it runs) and is harmless otherwise.
# Kill switch and panic (docs/security/kill-switch.md): shadow-killswitch.service
# is enabled on a fresh install but never started by the package: starting it
# applies the saved mode, and installing must not engage anything (the
# postinst reloads an already loaded kill switch instead). The panic reset runs
# at boot only. shadow-panic.service has no [Install]: it is started on demand.
# shadow-killswitch-watch.timer is enabled and started: its service only puts
# back a kill switch or panic table that was loaded in this boot and went
# missing, so it never engages anything on install; the service itself is
# only ever started by the timer.
# shadow-netprivacy.service is enabled but does nothing unless the kernel
# command line has shadow.netprivacy=off (the escape hatch of encrypted DNS and
# MAC privacy, docs/security/private-dns.md); installing never starts it.
override_dh_installsystemd-indep:
	dh_installsystemd -i -Nshadow-hardening
	dh_installsystemd -pshadow-hardening shadow-anon-boot.service
	dh_installsystemd -pshadow-hardening --no-enable --no-start shadow-anon-rotate.service shadow-anon-rotate.timer
	dh_installsystemd -pshadow-hardening --no-start shadow-killswitch.service shadow-panic-reset.service
	dh_installsystemd -pshadow-hardening --no-enable --no-start shadow-panic.service
	dh_installsystemd -pshadow-hardening shadow-killswitch-watch.timer
	dh_installsystemd -pshadow-hardening --no-enable --no-start shadow-killswitch-watch.service
	dh_installsystemd -pshadow-hardening --no-start shadow-netprivacy.service

# ---- architecture-independent packages: nothing to compile ------------------
override_dh_auto_configure-indep override_dh_auto_test-indep:
	@true

# Data packages (artwork, themes) come from the same CMake project configured
# without a compiler; the others are assembled by their debian/*.install files.
override_dh_auto_install-indep:
	cmake -S . -B $(DATA_BUILD) -DSHADOW_DATA_ONLY=ON -DCMAKE_INSTALL_PREFIX=/usr
	$(call install_components,$(DATA_PACKAGES),$(DATA_BUILD))

override_dh_auto_build-indep:
	mkdir -p $(GEN)
	scripts/gen-identity.sh $(GEN)
	scripts/gen-apt-source.sh $(GEN)
	python3 -m py_compile system/installer/engine/shadow_installer/*.py
	find system/installer/engine -name __pycache__ -prune -exec rm -rf {} +
	python3 tests/installation/test_plan.py

override_dh_auto_clean:
	dh_auto_clean
	rm -rf $(GEN) $(DATA_BUILD)

# The dpkg trigger of shadow-boot must not make package installation wait.
override_dh_installdeb:
	dh_installdeb
