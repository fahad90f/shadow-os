# /etc/default/grub — GRUB defaults for NEXUS OS.
#
# Run 'sudo update-grub' after changing this file. Distribution and
# installation-specific settings live in /etc/default/grub.d/*.cfg, which are
# read after this file; put local changes in your own file there (for example
# /etc/default/grub.d/90-local.cfg) so package updates never conflict.

GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="NEXUS OS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""
