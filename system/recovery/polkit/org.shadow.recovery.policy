<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Shadow OS</vendor>
  <vendor_url>https://github.com/fahad90fa/Custom-OS</vendor_url>

  <!--
    SHADOW Recovery (shadow-recovery) runs as the logged-in user and starts its
    engine through pkexec. This is the only action it uses, and it is bound
    to exactly one program.

    Default: an administrator must authenticate. The authorisation is kept
    for a few minutes ("auth_admin_keep"), because one repair consists of
    several engine runs (scan, mount, repair, unmount). In the live session,
    49-shadow-recovery-live.rules grants the action to the live user, who has
    no password to type.
  -->
  <action id="org.shadow.recovery.run">
    <description>Run the SHADOW Recovery engine</description>
    <message>Authentication is required to examine and repair an installed Shadow OS</message>
    <icon_name>org.shadow.recovery</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/sbin/shadow-recovery-engine</annotate>
  </action>
</policyconfig>
