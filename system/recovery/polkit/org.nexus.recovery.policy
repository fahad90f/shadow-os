<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>NEXUS OS</vendor>
  <vendor_url>https://github.com/fahad90fa/Custom-OS</vendor_url>

  <!--
    NEXUS Recovery (nexus-recovery) runs as the logged-in user and starts its
    engine through pkexec. This is the only action it uses, and it is bound
    to exactly one program.

    Default: an administrator must authenticate. The authorisation is kept
    for a few minutes ("auth_admin_keep"), because one repair consists of
    several engine runs (scan, mount, repair, unmount). In the live session,
    49-nexus-recovery-live.rules grants the action to the live user, who has
    no password to type.
  -->
  <action id="org.nexus.recovery.run">
    <description>Run the NEXUS Recovery engine</description>
    <message>Authentication is required to examine and repair an installed NEXUS OS</message>
    <icon_name>org.nexus.recovery</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/sbin/nexus-recovery-engine</annotate>
  </action>
</policyconfig>
