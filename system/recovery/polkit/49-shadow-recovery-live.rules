// SPDX-License-Identifier: GPL-3.0-or-later
//
// Shadow OS live session: let the live user run the recovery engine (polkit
// action org.shadow.recovery.run, i.e. exactly /usr/sbin/shadow-recovery-engine
// through pkexec) without a password.
//
// The grant applies only
//   * to that one action,
//   * to a local, active session of a member of the group "sudo" (the live
//     user; it has no password to type), and
//   * while /run/shadow/live-session exists. That marker is created at boot
//     by live-config (system/live/2000-shadow-session) on the live medium
//     only; /run is a tmpfs that only root can write to.
//
// On an installed system this rule returns nothing and the action's default
// (administrator authentication) applies.
polkit.addRule(function(action, subject) {
    if (action.id !== "org.shadow.recovery.run")
        return polkit.Result.NOT_HANDLED;
    if (!subject.local || !subject.active || !subject.isInGroup("sudo"))
        return polkit.Result.NOT_HANDLED;
    try {
        // Argument vector, no shell. Throws unless the command exits with 0.
        polkit.spawn(["/usr/bin/test", "-e", "/run/shadow/live-session"]);
    } catch (error) {
        return polkit.Result.NOT_HANDLED;
    }
    return polkit.Result.YES;
});
