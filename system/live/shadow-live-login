#!/bin/sh
# Make sure the live user exists and can log in. Run as the enabled
# shadow-live-login.service (ExecStart) on the live medium, before any login
# prompt. live-config does not create the live user on this image, so create
# it here. Output goes to the journal and console (see the .service), so the
# steps are visible in the boot log.
#
# Shipped only on the live medium by shadow-live; the installer removes it and
# the installed system uses the account created in the installer.
set -u

U="shadow"
P="${SHADOW_LIVE_PASSWORD:-live}"
H="/home/${U}"

log() { echo "shadow-live-login: $*"; }

log "start (uid=$(id -u 2>/dev/null))"
if touch /etc/.sll-wtest 2>/dev/null; then rm -f /etc/.sll-wtest; log "/etc is writable"; else log "/etc is NOT writable"; fi

if id "$U" >/dev/null 2>&1; then
    log "user already exists"
else
    # Give the account an existing primary group ("users"): the username
    # "shadow" collides with the system "shadow" group (which owns
    # /etc/shadow), so useradd/adduser refuse to auto-create a same-named
    # group. --no-create-home avoids the home-creation step rolling the whole
    # thing back; the home is set up by hand below.
    if useradd --no-create-home --gid users --shell /bin/bash --comment "Shadow Live Session" "$U"; then
        log "useradd ok"
    else
        log "useradd failed (rc=$?); trying adduser"
        adduser --disabled-password --no-create-home --ingroup users --gecos "Shadow Live Session" "$U" \
            || log "adduser failed (rc=$?)"
    fi
fi

# Home directory.
if id "$U" >/dev/null 2>&1; then
    mkdir -p "$H" 2>/dev/null || true
    [ -d /etc/skel ] && cp -aT /etc/skel "$H" 2>/dev/null || true
    chown -R "$U":"$U" "$H" 2>/dev/null || true
    usermod --home "$H" "$U" 2>/dev/null || true
fi

# Groups a desktop user needs (only those that exist).
for g in sudo audio video cdrom plugdev netdev bluetooth lpadmin scanner dialout kvm render input; do
    if getent group "$g" >/dev/null 2>&1; then
        usermod -aG "$g" "$U" 2>/dev/null || true
    fi
done

# Password + unlock.
if printf '%s:%s\n' "$U" "$P" | chpasswd; then
    log "password set via chpasswd"
else
    printf '%s\n%s\n' "$P" "$P" | passwd "$U" >/dev/null 2>&1 && log "password set via passwd" || log "password set FAILED"
fi
passwd -u "$U" >/dev/null 2>&1 || true

log "done: $(id "$U" 2>&1)"
exit 0
