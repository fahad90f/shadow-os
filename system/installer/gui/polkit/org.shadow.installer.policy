<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Shadow OS</vendor>
  <vendor_url>https://github.com/fahad90fa/Custom-OS</vendor_url>

  <!--
    The graphical installer (shadow-installer) runs as the logged-in user and
    starts the installation engine through pkexec. This is the only action it
    uses, and it is bound to exactly one program.

    Default: an administrator must authenticate, every time ("auth_admin":
    the authorisation is not kept, because the same program can erase a
    disk). In the live session, 49-shadow-installer-live.rules grants the
    action to the live user without a password.
  -->
  <action id="org.shadow.installer.run">
    <description>Run the Shadow OS installation engine</description>
    <message>Authentication is required to examine this computer's disks and to install Shadow OS</message>
    <icon_name>org.shadow.installer</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/sbin/shadow-installer-engine</annotate>
  </action>
</policyconfig>
