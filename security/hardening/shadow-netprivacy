# --------------------------------------------------------------------------- configuration reading
def parse_ini(text):
    """[(section, key, value)] in file order; comments and blank lines skipped."""
    entries, section = [], None
    for raw in (text or "").splitlines():
        line = raw.strip()
        if not line or line[0] in "#;":
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip()
            continue
        if "=" in line and section is not None:
            key, value = line.split("=", 1)
            entries.append((section, key.strip(), value.strip()))
    return entries


def dropin_files(directories):
    """Drop-in files in effect, in the order they are applied (systemd and NetworkManager rules)."""
    chosen = {}
    for directory in reversed(directories):         # lowest priority first, overridden below
        full = p(directory)
        try:
            names = os.listdir(full)
        except OSError:
            continue
        for name in names:
            if name.endswith(".conf") and not name.startswith("."):
                chosen[name] = os.path.join(directory, name)
    return [chosen[name] for name in sorted(chosen)]


RESOLVED_LISTS = ("DNS", "FallbackDNS", "Domains")


def resolved_config():
    """Effective [Resolve] settings and the files they come from."""
    files = []
    for main in RESOLVED_MAIN:
        if os.path.exists(p(main)):
            files.append(main)
            break
    files += dropin_files(RESOLVED_DROPINS)
    conf = {"DNS": [], "FallbackDNS": [], "Domains": []}
    for path in files:
        for section, key, value in parse_ini(read_text(path)):
            if section != "Resolve":
                continue
            if key in RESOLVED_LISTS:
                if value == "":
                    conf[key] = []
                else:
                    conf[key] += value.split()
            else:
                conf[key] = value
    return conf, files


def nm_config():
    """Effective NetworkManager [main], [device] and literal [connection] keys we report."""
    files = [NM_MAIN] if os.path.exists(p(NM_MAIN)) else []
    files += dropin_files(NM_DROPINS)
    merged = {}
    named_sections = []
    for path in files:
        for section, key, value in parse_ini(read_text(path)):
            if section in ("main", "device", "connection"):
                merged[(section, key)] = value
            elif section.startswith("connection-"):
                named_sections.append((path, section, key, value))
    return merged, named_sections, files


def info_of(text):
    """The '# shadow-netprivacy: a=b c=d' line of a file we wrote."""
    match = INFO_RE.search(text or "")
    if not match:
        return {}
    return dict(item.split("=", 1) for item in match.group(1).split() if "=" in item)


def classify_provider(servers):
    for ident, entry in PROVIDERS.items():
        if servers == entry["dot"]:
            return ident
    if not servers:
        return "network"
    return "custom"


def configured_dns(conf):
    dot = (conf.get("DNSOverTLS") or "no").lower()
    servers = conf["DNS"]
    if dot in ("yes", "true", "1", "on"):
        mode = "dot-strict"
    elif dot == "opportunistic":
        mode = "dot"
    elif servers == [DOH_LISTEN[0]] or servers == [f"{DOH_LISTEN[0]}:{DOH_LISTEN[1]}"]:
        mode = "doh"
    elif servers and servers != [DOH_LISTEN[0]]:
        mode = "plain"            # global servers without encryption (e.g. Hide Me's Tor DNSPort)
    else:
        mode = "off"
    provider = classify_provider(servers)
    if mode == "doh":
        doh = info_of(read_text(DNSCRYPT_CONFIG))
        provider = doh.get("provider", "unknown")
    return {"mode": mode,
            "provider": provider,
            "servers": list(servers),
            "dns_over_tls": {"1": "yes", "true": "yes", "on": "yes", "0": "no", "false": "no", "off": "no"}.get(dot, dot),
            "dnssec": {"1": "yes", "true": "yes", "on": "yes", "0": "no", "false": "no", "off": "no"}.get(
                (conf.get("DNSSEC") or "no").lower(), (conf.get("DNSSEC") or "no").lower()),
            "all_names_to_provider": "~." in conf["Domains"],
            "fallback_servers": list(conf["FallbackDNS"]),
            "llmnr": (conf.get("LLMNR") or "yes").lower(),
            "mdns": (conf.get("MulticastDNS") or "yes").lower()}


def configured_mac(merged):
    stable_id = merged.get(("connection", "connection.stable-id"), "")
    wifi = merged.get(("connection", "wifi.cloned-mac-address"), "preserve")
    ethernet = merged.get(("connection", "ethernet.cloned-mac-address"), "preserve")
    if wifi in ("permanent", "preserve") and ethernet in ("permanent", "preserve"):
        mode = "hardware"
    elif wifi == "stable" and ethernet == "stable":
        mode = "per-boot" if "${BOOT}" in stable_id else "per-network"
    elif "random" in (wifi, ethernet):
        mode = "random"
    else:
        mode = "custom"
    scan = merged.get(("device", "wifi.scan-rand-mac-address"), "yes").lower() in ("yes", "true", "1", "on")
    return {"mode": mode, "stable_id": stable_id, "wifi": wifi, "ethernet": ethernet,
            "scan_randomization": scan}


# --------------------------------------------------------------------------- live state
def busctl_properties(names):
    """Properties of org.freedesktop.resolve1.Manager, or None when resolved does not answer."""
    rc, out, _ = run(["busctl", "--json=short", "get-property", "org.freedesktop.resolve1",
                      "/org/freedesktop/resolve1", "org.freedesktop.resolve1.Manager", *names],
                     check=False, timeout=10)
    if rc != 0:
        return None
    values = []
    for line in out.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            values.append(json.loads(line))
        except ValueError:
            return None
    if len(values) != len(names):
        return None
    return dict(zip(names, values))


def server_text(entry):
    """CurrentDNSServerEx (iiayqs) -> '9.9.9.9#dns.quad9.net' (None for no server)."""
    try:
        _ifindex, family, raw, port, name = entry
        if not raw:
            return None
        addr = ipaddress.ip_address(bytes(raw))
        text = f"[{addr}]:{port}" if (port and port != 53 and family == socket.AF_INET6) else (
            f"{addr}:{port}" if port and port != 53 else str(addr))
        return f"{text}#{name}" if name else text
    except (TypeError, ValueError):
        return None


def live_dns():
    props = busctl_properties(["DNSOverTLS", "DNSSEC", "LLMNR", "MulticastDNS", "CurrentDNSServerEx"])
    if props is None:
        return None
    return {"dns_over_tls": props["DNSOverTLS"].get("data"),
            "dnssec": props["DNSSEC"].get("data"),
            "llmnr": props["LLMNR"].get("data"),
            "mdns": props["MulticastDNS"].get("data"),
            "current_server": server_text(props["CurrentDNSServerEx"].get("data"))}


def resolv_conf_state():
    path = p(RESOLV_CONF)
    if os.path.islink(path):
        target = os.readlink(path)
        if target in STUB_TARGETS:
            kind = "stub"
        elif target.endswith("/run/systemd/resolve/resolv.conf"):
            kind = "resolved-uplinks"
        elif target.endswith("/run/NetworkManager/resolv.conf"):
            kind = "networkmanager"
        else:
            kind = "other-link"
        return {"kind": kind, "target": target, "dangling": not os.path.exists(path)}
    if os.path.exists(path):
        text = read_text(RESOLV_CONF) or ""
        servers = re.findall(r"^\s*nameserver\s+(\S+)", text, re.M)
        kind = "stub-copy" if servers == ["127.0.0.53"] else "file"
        return {"kind": kind, "target": None, "dangling": False}
    return {"kind": "missing", "target": None, "dangling": False}


def nss_resolve_enabled():
    for line in (read_text(NSSWITCH) or "").splitlines():
        line = line.split("#", 1)[0]
        if line.strip().startswith("hosts:"):
            return re.search(r"\bresolve\b", line) is not None
    return False


def nm_exceptions():
    """UUIDs of Wi-Fi/Ethernet profiles pinned to one address (stable-id ${CONNECTION}); None: unknown."""
    rc, out, _ = run(["nmcli", "-t", "-f", "UUID,TYPE", "connection", "show"], check=False, timeout=15)
    if rc != 0:
        return None
    found = []
    for line in out.splitlines():
        uuid, _, kind = line.partition(":")
        if not UUID_RE.match(uuid) or kind not in MAC_TYPES:
            continue
        rc, value, _ = run(["nmcli", "-g", "connection.stable-id", "connection", "show", uuid],
                           check=False, timeout=15)
        if rc == 0 and value.strip() == EXCEPTION_STABLE_ID:
            found.append(uuid)
    return found


def status():
    errors, warnings = [], []
    conf, resolved_files = resolved_config()
    dns = configured_dns(conf)
    installed = os.path.exists(p(RESOLVED_BINARY))
    active = installed and unit_active(RESOLVED_UNIT)
    override = None
    if os.path.exists(p(RESOLVED_HIDEME)):
        override = "hide-me"
    if os.path.exists(p(RESOLVED_ESCAPE)):
        override = "escape"
    user_text = read_text(RESOLVED_USER)
    dns.update({
        "source": "user" if user_text is not None else ("default" if os.path.exists(p(RESOLVED_DEFAULT)) else "none"),
        "override": override,
        "resolver_installed": installed,
        "resolver_active": active,
        "resolv_conf": resolv_conf_state(),
        "nss_resolve": nss_resolve_enabled(),
        "files": resolved_files,
        "live": live_dns() if active else None,
    })
    doh_installed = os.path.exists(p(DNSCRYPT_BINARY))
    dns["doh"] = {"installed": doh_installed,
                  "configured": os.path.exists(p(DNSCRYPT_DROPIN)),
                  "active": doh_installed and any(unit_active(u) for u in DNSCRYPT_UNITS),
                  "listen": f"{DOH_LISTEN[0]}:{DOH_LISTEN[1]}"}

    # How much of the DNS traffic is encrypted, from what is in force.
    live = dns["live"]
    # Hide Me's file counts only when Tor's DNSPort is the only global server
    # (DNS= adds up across files) and, as far as resolved reports it, in use.
    hide_me_tor = (override == "hide-me" and dns["servers"] == [HIDEME_TOR_DNS]
                   and (live is None or live["current_server"] in (None, HIDEME_TOR_DNS)))
    if not active:
        encrypted = "unknown"
        if installed:
            errors.append("systemd-resolved is not running: no name can be looked up "
                          "(sudo systemctl restart systemd-resolved)")
        else:
            errors.append("systemd-resolved is not installed: DNS is not encrypted")
    elif hide_me_tor:
        encrypted = "tor"
    elif dns["mode"] == "doh":
        encrypted = "always" if dns["all_names_to_provider"] else "partly"
        if not dns["doh"]["active"]:
            errors.append("dnscrypt-proxy is not running: no name can be looked up in DNS-over-HTTPS mode")
    elif live is None:
        encrypted = "unknown"
        errors.append("systemd-resolved does not answer on the system bus")
    elif live["dns_over_tls"] == "yes":
        encrypted = "always" if dns["all_names_to_provider"] else "partly"
    elif live["dns_over_tls"] == "opportunistic":
        encrypted = "opportunistic" if dns["all_names_to_provider"] else "partly"
    else:
        encrypted = "no"
    dns["encrypted"] = encrypted
    if active and override == "hide-me" and not hide_me_tor:
        in_use = f"; in use: {live['current_server']}" if live and live.get("current_server") else ""
        errors.append("Hide Me's DNS-over-Tor is not in force: systemd-resolved's global DNS servers are "
                      f"{' '.join(dns['servers']) or 'none'}{in_use}, not Tor's DNSPort alone "
                      "(turn DNS protection off and on again in Hide Me)")
    if live is not None and live.get("dns_over_tls") != dns["dns_over_tls"] and override is None:
        warnings.append("systemd-resolved runs with other settings than its files: "
                        "sudo systemctl restart systemd-resolved")
    if dns["resolv_conf"]["kind"] not in ("stub", "stub-copy"):
        warnings.append("/etc/resolv.conf does not point at systemd-resolved's stub "
                        f"({dns['resolv_conf']['kind']}): programs reading it bypass encrypted DNS")
    elif dns["resolv_conf"]["dangling"] and active:
        warnings.append("/etc/resolv.conf points at a file systemd-resolved has not written")
    if dns["nss_resolve"]:
        warnings.append("libnss-resolve is enabled in /etc/nsswitch.conf: lookups bypass /etc/resolv.conf "
                        "and Hide Me's DNS redirect")
    if dns["fallback_servers"]:
        warnings.append("fallback DNS servers are configured: they are asked when the provider fails")

    merged, named, nm_files = nm_config()
    mac = configured_mac(merged)
    mac["source"] = "user" if os.path.exists(p(NM_USER)) else (
        "default" if os.path.exists(p(NM_DEFAULT)) else "none")
    mac["override"] = "escape" if os.path.exists(p(NM_ESCAPE)) else None
    if mac["override"] == "escape":
        mac["mode"] = "hardware"
    mac["fixed_drivers"] = sorted({d for _, section, key, value in named if key == "match-device"
                                   for d in re.findall(r"driver:([A-Za-z0-9_.-]+)", value)})
    exceptions = nm_exceptions()
    mac["exceptions"] = exceptions if exceptions is not None else []
    mac["exceptions_known"] = exceptions is not None
    mac["dns_plugin"] = merged.get(("main", "dns"), "default")
    mac["files"] = nm_files
    if mac["mode"] == "random":
        warnings.append("a new random MAC address at every connection is configured: networks then "
                        "block the 'new device' and DHCP pools run out (shadow-netprivacy mac per-boot)")
    if mac["dns_plugin"] not in ("systemd-resolved", "default"):
        warnings.append(f"NetworkManager's DNS plugin is '{mac['dns_plugin']}', not systemd-resolved")
    return {"version": 1, "escape_hatch": cmdline_escape(), "dns": dns, "mac": mac,
            "errors": errors, "warnings": warnings}


def print_status(info):
    dns, mac = info["dns"], info["mac"]
    names = {"dot": "DNS-over-TLS when the provider offers it",
             "dot-strict": "DNS-over-TLS only",
             "doh": "DNS-over-HTTPS (dnscrypt-proxy)",
             "off": "the network's own DNS servers",
             "plain": "fixed servers without encryption"}
    print(f"DNS:        {names.get(dns['mode'], dns['mode'])}"
          + (f", provider {dns['provider']}" if dns["mode"] not in ("off",) else ""))
    print(f"            DNSSEC {dns['dnssec']}; encrypted: {dns['encrypted']}"
          + (f"; live: DNSOverTLS={dns['live']['dns_over_tls']} DNSSEC={dns['live']['dnssec']}"
             if dns["live"] else ""))
    if dns["override"] == "hide-me":
        print("            Hide Me sends DNS through Tor right now")
    print(f"MAC:        {mac['mode']}" + (f" (stable-id {mac['stable_id']})" if mac["stable_id"] else "")
          + f"; {len(mac['exceptions'])} network(s) with a fixed address")
    if info["escape_hatch"]:
        print("            shadow.netprivacy=off is on the kernel command line: all of the above is off for this boot")
    for message in info["errors"]:
        print(f"ERROR:      {message}")
    for message in info["warnings"]:
        print(f"WARNING:    {message}")


# --------------------------------------------------------------------------- DoH
def dns_probe(addr, port, timeout=3.0):
    """Send '. IN NS' and return True when a NOERROR answer with our id comes back."""
    query_id = secrets.randbits(16)
    packet = struct.pack(">HHHHHH", query_id, 0x0100, 1, 0, 0, 0) + b"\x00" + struct.pack(">HH", 2, 1)
    family = socket.AF_INET6 if ":" in addr else socket.AF_INET
    with socket.socket(family, socket.SOCK_DGRAM) as sock:
        sock.settimeout(timeout)
        try:
            sock.sendto(packet, (addr, port))
            data, _ = sock.recvfrom(4096)
        except OSError:
            return False
    if len(data) < 12:
        return False
    rid, flags = struct.unpack(">HH", data[:4])
    return rid == query_id and bool(flags & 0x8000) and (flags & 0x000F) == 0


def wait_for_doh(attempts=5, pause=2.0):
    for attempt in range(attempts):
        if dns_probe(*DOH_LISTEN):
            return True
        if attempt + 1 < attempts:
            time.sleep(pause)
    return False


def doh_setup(provider):
    """Configure, start and test dnscrypt-proxy. Returns an undo function."""
    if not os.path.exists(p(DNSCRYPT_BINARY)):
        raise Failure("DNS-over-HTTPS needs the dnscrypt-proxy package: sudo apt install dnscrypt-proxy")
    old_config, old_dropin = read_text(DNSCRYPT_CONFIG), read_text(DNSCRYPT_DROPIN)
    was_active = any(unit_active(u) for u in DNSCRYPT_UNITS)

    def undo():
        restore(DNSCRYPT_CONFIG, old_config)
        restore(DNSCRYPT_DROPIN, old_dropin)
        run(["systemctl", "daemon-reload"], check=False)
        if old_dropin is None:
            run(["systemctl", "disable", "--now", *DNSCRYPT_UNITS], check=False)
        elif was_active:
            run(["systemctl", "restart", *DNSCRYPT_UNITS], check=False)

    write_atomic(DNSCRYPT_CONFIG, render_dnscrypt(provider))
    try:
        rc, out, err = run([DNSCRYPT_BINARY, "-config", p(DNSCRYPT_CONFIG), "-check"], check=False)
        if rc != 0:
            raise Failure("dnscrypt-proxy rejected the configuration: " + (err or out).strip())
        write_atomic(DNSCRYPT_DROPIN, render_dnscrypt_dropin())
        run(["systemctl", "daemon-reload"])
        # Debian's helper hands 127.0.2.1 to resolvconf; here systemd-resolved
        # forwards to it instead, so the helper stays off.
        run(["systemctl", "disable", "--now", DNSCRYPT_RESOLVCONF_UNIT], check=False)
        run(["systemctl", "enable", *DNSCRYPT_UNITS])
        run(["systemctl", "restart", *DNSCRYPT_UNITS])
        if not wait_for_doh():
            raise Failure("dnscrypt-proxy does not answer on 127.0.2.1:53 (no connection to the DNS-over-HTTPS "
                          "server? 'journalctl -u dnscrypt-proxy'); DNS settings were not changed")
    except BaseException:
        undo()
        raise
    return undo


def doh_teardown():
    """Leave DNS-over-HTTPS mode: stop dnscrypt-proxy and remove our files."""
    problems = []
    rc, out, err = run(["systemctl", "disable", "--now", *DNSCRYPT_UNITS], check=False)
    if rc != 0:
        problems.append("could not stop dnscrypt-proxy: " + (err or out).strip())
    remove(DNSCRYPT_DROPIN)
    remove(DNSCRYPT_CONFIG)
    rc, out, err = run(["systemctl", "daemon-reload"], check=False)
    if rc != 0:
        problems.append("systemctl daemon-reload failed: " + (err or out).strip())
    return problems


# --------------------------------------------------------------------------- commands
def restart_resolved_and_verify():
    """Restart resolved; return None when it runs with the configured DNSOverTLS, else an error text."""
    rc, out, err = run(["systemctl", "restart", RESOLVED_UNIT], check=False)
    if rc != 0:
        return "systemd-resolved did not restart: " + (err or out).strip()
    conf, _ = resolved_config()
    configured = configured_dns(conf)
    want = (configured["dns_over_tls"], configured["dnssec"])
    for _ in range(10):
        live = live_dns()
        if live is not None and (live["dns_over_tls"], live["dnssec"]) == want:
            return None
        time.sleep(0.5)
    live = live_dns()
    if live is None:
        return "systemd-resolved does not answer after the restart"
    return (f"systemd-resolved reports DNSOverTLS={live['dns_over_tls']} DNSSEC={live['dnssec']}, "
            f"the files say DNSOverTLS={want[0]} DNSSEC={want[1]}")


def is_default_dns(mode, provider, dnssec):
    return mode == DEFAULT_MODE and provider["id"] == DEFAULT_PROVIDER and dnssec == DEFAULT_DNSSEC


def cmd_dns(mode, provider_spec, dnssec):
    provider, dnssec = validate_dns_request(mode, provider_spec, dnssec)
    require_root()
    if not os.path.exists(p(RESOLVED_BINARY)):
        raise Failure("systemd-resolved is not installed (sudo apt install systemd-resolved)")
    with Lock():
        conf, _ = resolved_config()
        was_doh = configured_dns(conf)["mode"] == "doh" or os.path.exists(p(DNSCRYPT_DROPIN))
        old_user = read_text(RESOLVED_USER)
        undo_doh = doh_setup(provider) if mode == "doh" else None
        try:
            if is_default_dns(mode, provider, dnssec) and os.path.exists(p(RESOLVED_DEFAULT)):
                remove(RESOLVED_USER)
            else:
                write_atomic(RESOLVED_USER, render_resolved(mode, provider, dnssec))
            error = restart_resolved_and_verify()
            if error:
                restore(RESOLVED_USER, old_user)
                again = restart_resolved_and_verify()
                raise Failure(error + "; the previous setting was put back"
                              + ("" if again is None else f" (but: {again})"))
        except BaseException:
            if undo_doh:
                undo_doh()
            raise
        problems = doh_teardown() if (was_doh and mode != "doh") else []
    shown = {"dot": "DNS-over-TLS (falls back to plain DNS where port 853 is blocked)",
             "dot-strict": "DNS-over-TLS only", "doh": "DNS-over-HTTPS through dnscrypt-proxy",
             "off": "the network's own DNS servers"}[mode]
    print(f"DNS: {shown}" + ("" if mode == "off" else f", provider {provider['name']}") + f", DNSSEC {dnssec}.")
    if os.path.exists(p(RESOLVED_HIDEME)):
        print("Note: Hide Me sends DNS through Tor right now; this setting applies when its DNS protection is off.")
    if cmdline_escape():
        print("Note: shadow.netprivacy=off is on the kernel command line; this setting applies from the next boot.")
    if problems:
        raise Failure("DNS changed, but leaving DNS-over-HTTPS mode was incomplete: " + "; ".join(problems))


def reload_nm():
    """Make NetworkManager read its configuration; None when done or not running, else an error."""
    if not unit_active(NM_UNIT):
        return None
    rc, out, err = run(["nmcli", "general", "reload", "conf"], check=False)
    if rc != 0:
        return "NetworkManager did not reload its configuration: " + (err or out).strip()
    return None


def cmd_mac(mode):
    if mode not in MAC_MODES:
        raise Failure(f"unknown MAC mode '{mode}'; choose one of {', '.join(MAC_MODES)}")
    require_root()
    with Lock():
        text = render_mac(mode)
        if text is None:
            remove(NM_USER)
        else:
            write_atomic(NM_USER, text)
        error = reload_nm()
    print({"per-boot": "MAC address: a private address per network, new at every boot.",
           "per-network": "MAC address: a private address per network that stays the same across boots.",
           "hardware": "MAC address: the device's real hardware address."}[mode])
    print("Nothing was reconnected: each network takes its new address the next time it connects.")
    if error:
        raise Failure(error + " (the file is written; it applies when NetworkManager restarts)")


def nm_get(uuid, field):
    rc, out, err = run(["nmcli", "-g", field, "connection", "show", uuid], check=False, timeout=15)
    if rc != 0:
        raise Failure(f"no NetworkManager connection with UUID {uuid}: {(err or out).strip()}")
    return out.rstrip("\n")


def cmd_mac_exception(action, uuid):
    if action not in ("add", "remove"):
        raise Failure("expected add or remove")
    if not UUID_RE.match(uuid or ""):
        raise Failure(f"'{uuid}' is not a connection UUID (nmcli -f NAME,UUID connection show)")
    require_root()
    uuid = uuid.lower()
    with Lock():
        kind = nm_get(uuid, "connection.type")
        if kind not in MAC_TYPES:
            raise Failure(f"connection {uuid} is a {kind} connection; MAC addresses apply to Wi-Fi and Ethernet")
        current = nm_get(uuid, "connection.stable-id")
        if action == "add":
            if current == EXCEPTION_STABLE_ID:
                print("This network already keeps its address across boots.")
                return
            if current:
                raise Failure(f"connection {uuid} already has its own stable-id ('{current}'); "
                              "clear it first: nmcli connection modify <uuid> connection.stable-id ''")
            run(["nmcli", "connection", "modify", uuid, "connection.stable-id", EXCEPTION_STABLE_ID])
            check = nm_get(uuid, "connection.stable-id")
            if check != EXCEPTION_STABLE_ID:
                raise Failure(f"NetworkManager did not store the exception (stable-id is '{check}')")
            print("This network keeps one private address across boots, from its next connection on.")
        else:
            if current != EXCEPTION_STABLE_ID:
                raise Failure(f"connection {uuid} has no MAC exception")
            run(["nmcli", "connection", "modify", uuid, "connection.stable-id", ""])
            check = nm_get(uuid, "connection.stable-id")
            if check:
                raise Failure(f"NetworkManager did not remove the exception (stable-id is '{check}')")
            print("This network follows the MAC policy again, from its next connection on.")


def cmd_boot():
    """shadow-netprivacy.service: honour shadow.netprivacy=off for this boot."""
    if cmdline_escape():
        write_atomic(RESOLVED_ESCAPE, render_escape_resolved())
        write_atomic(NM_ESCAPE, render_escape_nm())
        print("shadow.netprivacy=off: encrypted DNS and MAC privacy are off for this boot")
    else:
        removed = remove(RESOLVED_ESCAPE) | remove(NM_ESCAPE)
        if removed:
            print("removed the overrides of an earlier shadow.netprivacy=off")


# --------------------------------------------------------------------------- main
def main(argv=None):
    parser = argparse.ArgumentParser(prog="shadow-netprivacy",
                                     description="Encrypted DNS and MAC address policy of Shadow OS.")
    sub = parser.add_subparsers(dest="command", required=True)
    st = sub.add_parser("status", help="show what is in force")
    st.add_argument("--json", action="store_true")
    dn = sub.add_parser("dns", help="choose how names are looked up")
    dn.add_argument("mode", choices=MODES)
    dn.add_argument("--provider", default=None)
    dn.add_argument("--dnssec", default=None, choices=DNSSEC_VALUES)
    mc = sub.add_parser("mac", help="choose the MAC address policy")
    mc.add_argument("mode", choices=MAC_MODES)
    ex = sub.add_parser("mac-exception", help="keep one network's address across boots")
    ex.add_argument("action", choices=("add", "remove"))
    ex.add_argument("uuid")
    sub.add_parser("boot", help="used by shadow-netprivacy.service at boot")
    args = parser.parse_args(argv)
    try:
        if args.command == "status":
            info = status()
            if args.json:
                print(json.dumps(info, indent=2, sort_keys=True))
            else:
                print_status(info)
            return 0
        if args.command == "dns":
            cmd_dns(args.mode, args.provider, args.dnssec)
        elif args.command == "mac":
            cmd_mac(args.mode)
        elif args.command == "mac-exception":
            cmd_mac_exception(args.action, args.uuid)
        elif args.command == "boot":
            require_root()
            cmd_boot()
        return 0
    except Failure as exc:
        print(f"shadow-netprivacy: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
