class Failure(Exception):
    pass


# --------------------------------------------------------------------------- helpers
def p(path):
    return ROOT + path


def run(argv, check=True, timeout=TOOL_TIMEOUT):
    """Run a program without a shell. Returns (rc, stdout, stderr); rc 127: missing, 124: timeout."""
    env = dict(os.environ, LC_ALL="C.UTF-8", LANGUAGE="C", SYSTEMD_PAGER="cat", SYSTEMD_COLORS="0")
    try:
        proc = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              env=env, timeout=timeout)
        rc, out, err = proc.returncode, proc.stdout.decode("utf-8", "replace"), proc.stderr.decode("utf-8", "replace")
    except FileNotFoundError:
        rc, out, err = 127, "", f"{argv[0]} is not installed"
    except subprocess.TimeoutExpired:
        rc, out, err = 124, "", f"{argv[0]} did not finish within {timeout} s"
    if check and rc != 0:
        raise Failure(f"{' '.join(argv)} failed: {(err or out).strip() or f'exit status {rc}'}")
    return rc, out, err


def read_text(path):
    try:
        with open(p(path), encoding="utf-8") as fh:
            return fh.read()
    except FileNotFoundError:
        return None
    except OSError as exc:
        raise Failure(f"cannot read {path}: {exc}")


def write_atomic(path, text, mode=0o644):
    target = p(path)
    directory = os.path.dirname(target)
    os.makedirs(directory, mode=0o755, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix="." + os.path.basename(target) + ".")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, target)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def remove(path):
    try:
        os.unlink(p(path))
        return True
    except FileNotFoundError:
        return False


def restore(path, text):
    """Put a file back as it was (None: it did not exist)."""
    if text is None:
        remove(path)
    else:
        write_atomic(path, text)


def require_root():
    if os.geteuid() != 0:
        raise Failure("this command must run as root (use sudo, or pkexec from the desktop)")


class Lock:
    """Serialises the commands that change something.

    The lock file is root-only and never a symbolic link (as shadow-killswitch's
    and shadow-panic's): flock() works on a descriptor opened read-only, so a
    file other users could open would let any of them hold the lock and keep
    every DNS and MAC change from being made.
    """
    def __enter__(self):
        path = p(LOCK_FILE)
        os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
        try:
            self.fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        except OSError as exc:
            raise Failure(f"cannot open the lock file {path}: {exc.strerror}")
        os.fchmod(self.fd, 0o600)      # a file left by an older version, or a umask
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            os.close(self.fd)
            raise Failure("another shadow-netprivacy command is running; try again in a moment")
        return self

    def __exit__(self, *exc):
        os.close(self.fd)


def cmdline_escape():
    text = read_text(CMDLINE) or ""
    return f"{ESCAPE_PARAM}=off" in text.split()


def unit_active(unit):
    rc, out, _ = run(["systemctl", "is-active", unit], check=False)
    return out.strip() == "active"


# --------------------------------------------------------------------------- validation
def parse_server(spec):
    """'<ip>#<tls name>' -> normalised string; raises Failure."""
    if spec.count("#") != 1:
        raise Failure(f"'{spec}': expected <ip>#<tls name>, e.g. 192.0.2.53#dns.example.net")
    addr_text, name = spec.split("#")
    try:
        addr = ipaddress.ip_address(addr_text)
    except ValueError:
        raise Failure(f"'{addr_text}' is not an IP address (host names are not accepted: "
                      "the server must be reachable before any name can be looked up)")
    if addr.is_unspecified or addr.is_multicast:
        raise Failure(f"'{addr_text}' cannot be a DNS server")
    if addr.is_loopback:
        raise Failure(f"'{addr_text}' is this computer; a local resolver would loop back to systemd-resolved")
    if not HOSTNAME_RE.match(name):
        raise Failure(f"'{name}' is not a valid TLS server name (a fully qualified host name)")
    return f"{addr.compressed}#{name.lower()}"


def parse_provider(spec):
    """--provider value -> {"id", "name", "dot": [...], "doh": [...]}."""
    spec = (spec or DEFAULT_PROVIDER).strip()
    if spec in PROVIDERS:
        entry = dict(PROVIDERS[spec])
        entry["id"] = spec
        return entry
    if spec.startswith("custom:"):
        items = [item.strip() for item in spec[len("custom:"):].split(",") if item.strip()]
        if not items:
            raise Failure("custom provider: give at least one <ip>#<tls name>")
        if len(items) > MAX_CUSTOM_SERVERS:
            raise Failure(f"custom provider: at most {MAX_CUSTOM_SERVERS} servers")
        servers = []
        for item in items:
            server = parse_server(item)
            if server not in servers:
                servers.append(server)
        return {"id": "custom", "name": "custom", "dot": servers, "doh": [], "props": 0}
    raise Failure(f"unknown provider '{spec}'; choose quad9, mullvad, cloudflare or custom:<ip>#<tls name>[,...]")


def validate_dns_request(mode, provider_spec, dnssec):
    if mode not in MODES:
        raise Failure(f"unknown DNS mode '{mode}'; choose one of {', '.join(MODES)}")
    dnssec = dnssec or DEFAULT_DNSSEC
    if dnssec not in DNSSEC_VALUES:
        raise Failure(f"--dnssec must be one of {', '.join(DNSSEC_VALUES)}")
    provider = parse_provider(provider_spec)
    if mode == "doh" and not provider["doh"]:
        raise Failure("DNS-over-HTTPS works with the providers quad9, mullvad and cloudflare; "
                      "a custom server needs dot or dot-strict")
    if mode == "off" and provider_spec:
        raise Failure("'off' uses the network's own DNS servers; --provider does not apply")
    return provider, dnssec


# --------------------------------------------------------------------------- rendering
def render_resolved(mode, provider, dnssec):
    """Text of /etc/systemd/resolved.conf.d/90-shadow-user.conf."""
    info = f"mode={mode} provider={provider['id'] if mode != 'off' else 'network'} dnssec={dnssec}"
    lines = [MARK,
             "# Change it with: sudo shadow-netprivacy dns {dot|dot-strict|doh|off} [--provider ...] [--dnssec ...]",
             f"# shadow-netprivacy: {info}",
             "",
             "[Resolve]",
             "DNS="]
    if mode in ("dot", "dot-strict"):
        lines.append("DNS=" + " ".join(provider["dot"]))
    elif mode == "doh":
        lines.append(f"DNS={DOH_LISTEN[0]}")
    lines.append("Domains=")
    if mode != "off":
        # Every name goes to the servers above, none to the network's own
        # server in plain text (it keeps answering for the network's domains).
        lines.append("Domains=~.")
    lines += ["FallbackDNS=",
              f"DNSOverTLS={DOT_SETTING[mode]}",
              f"DNSSEC={dnssec}",
              "LLMNR=no",
              "MulticastDNS=no"]
    return "\n".join(lines) + "\n"


def doh_stamp(addr, hostname, path, props):
    """A DNS-over-HTTPS server stamp (protocol 0x02) without certificate pins."""
    def lp(text):
        data = text.encode("ascii")
        if len(data) > 255:
            raise Failure(f"stamp field too long: {text}")
        return bytes([len(data)]) + data
    raw = bytes([0x02]) + struct.pack("<Q", props) + lp(addr) + b"\x00" + lp(hostname) + lp(path)
    return "sdns://" + base64.urlsafe_b64encode(raw).decode("ascii").rstrip("=")


def parse_stamp(stamp):
    """Inverse of doh_stamp (for status and tests): {"addr", "hostname", "path", "props"}."""
    if not stamp.startswith("sdns://"):
        raise ValueError("not a stamp")
    body = stamp[len("sdns://"):]
    raw = base64.urlsafe_b64decode(body + "=" * (-len(body) % 4))
    if raw[0] != 0x02:
        raise ValueError("not a DoH stamp")
    props = struct.unpack("<Q", raw[1:9])[0]
    pos = 9

    def take():
        nonlocal pos
        length = raw[pos]
        value = raw[pos + 1:pos + 1 + length].decode("ascii")
        pos += 1 + length
        return value
    addr = take()
    while raw[pos] & 0x80:                       # skip certificate hashes
        pos += 1 + (raw[pos] & 0x7F)
    pos += 1 + raw[pos]
    hostname = take()
    path = take()
    return {"addr": addr, "hostname": hostname, "path": path, "props": props}


def render_dnscrypt(provider):
    names = [f"shadow-{provider['id']}-{i + 1}" for i in range(len(provider["doh"]))]
    first_ip = provider["doh"][0][0]
    lines = [MARK,
             "# DNS-over-HTTPS mode of shadow-netprivacy; dnscrypt-proxy.service reads this file",
             "# through /etc/systemd/system/dnscrypt-proxy.service.d/50-shadow-netprivacy.conf.",
             f"# shadow-netprivacy: provider={provider['id']}",
             "",
             "# dnscrypt-proxy.socket listens on 127.0.2.1:53 (socket activation).",
             "listen_addresses = []",
             "server_names = [" + ", ".join(f"'{n}'" for n in names) + "]",
             "ipv4_servers = true",
             "ipv6_servers = false",
             "dnscrypt_servers = false",
             "doh_servers = true",
             "odoh_servers = false",
             "require_dnssec = false",
             "require_nolog = false",
             "require_nofilter = false",
             "# The servers below are given by address: no resolver list is downloaded",
             "# and no name has to be looked up before the first query.",
             f"bootstrap_resolvers = ['{first_ip}:53']",
             "ignore_system_dns = true",
             f"netprobe_address = '{first_ip}:53'",
             "netprobe_timeout = 60",
             "block_ipv6 = false",
             "cache = true",
             "# No [query_log] and no [nx_log]: lookups are never written anywhere.",
             "",
             "[static]"]
    for name, (addr, hostname, path) in zip(names, provider["doh"]):
        lines += [f"  [static.'{name}']", f"  stamp = '{doh_stamp(addr, hostname, path, provider['props'])}'"]
    return "\n".join(lines) + "\n"


