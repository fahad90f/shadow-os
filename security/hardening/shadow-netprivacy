def render_mac(mode):
    """Text of /etc/NetworkManager/conf.d/90-shadow-mac.conf (None: shipped default)."""
    if mode == "per-boot":
        return None
    lines = [MARK, "# Change it with: sudo shadow-netprivacy mac {per-boot|per-network|hardware}",
             f"# shadow-netprivacy: mac={mode}", "", "[connection]"]
    if mode == "per-network":
        lines += ["# A private address per network that stays the same across boots.",
                  f"connection.stable-id={STABLE_PER_NETWORK}",
                  "wifi.cloned-mac-address=stable",
                  "ethernet.cloned-mac-address=stable"]
    elif mode == "hardware":
        lines += ["# The device's real hardware address on every network (scanning",
                  "# still uses random addresses).",
                  "wifi.cloned-mac-address=permanent",
                  "ethernet.cloned-mac-address=permanent"]
    else:
        raise Failure(f"unknown MAC mode '{mode}'")
    return "\n".join(lines) + "\n"


def render_escape_resolved():
    return "\n".join([
        "# shadow.netprivacy=off on the kernel command line (shadow-netprivacy boot):",
        "# for this boot, the DNS servers of the network are used without encryption.",
        "[Resolve]",
        "DNS=",
        "Domains=",
        "DNSOverTLS=no",
