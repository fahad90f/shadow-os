## NEXUS OS audit rules — loaded by augenrules from /etc/audit/rules.d/.
## A deliberately small, low-noise set: changes to identity, privilege and
## kernel code, which is what an investigation needs first. The rules are not
## locked (-e 2), so they can be extended without a reboot.

# Identity and authentication databases
# Some watched paths exist only on some systems (an SSH server, an installed
# boot loader). Without -i one missing path makes the whole rule set fail to
# load; with it the remaining rules are loaded and the miss is logged.
-i

-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/security/opasswd -p wa -k identity

# Privilege configuration
-w /etc/sudoers -p wa -k privilege
-w /etc/sudoers.d/ -p wa -k privilege
-w /etc/polkit-1/ -p wa -k privilege
-w /usr/share/polkit-1/rules.d/ -p wa -k privilege

# Authentication stack and remote access configuration
-w /etc/pam.d/ -p wa -k auth-config
-w /etc/ssh/sshd_config -p wa -k auth-config
-w /etc/ssh/sshd_config.d/ -p wa -k auth-config

# Security policy: firewall, AppArmor, audit itself
-w /etc/nftables.conf -p wa -k firewall
-w /etc/nftables.d/ -p wa -k firewall
-w /etc/apparmor.d/ -p wa -k mac-policy
-w /etc/audit/ -p wa -k audit-config

# Kernel module loading and unloading
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -F auid>=1000 -F auid!=unset -k modules
-w /etc/modprobe.d/ -p wa -k modules

# System time changes
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -F auid>=1000 -F auid!=unset -k time-change

# Boot chain
-w /boot/grub/grub.cfg -p wa -k boot
-w /etc/default/grub -p wa -k boot
-w /etc/default/grub.d/ -p wa -k boot
-w /etc/nexus/boot.conf -p wa -k boot

# Package sources
-w /etc/apt/sources.list.d/ -p wa -k apt-sources
-w /etc/apt/trusted.gpg.d/ -p wa -k apt-sources
