"""shadow-firewall — manage the Shadow OS host firewall.

    shadow-firewall status [--json]
    shadow-firewall enable | disable
    shadow-firewall allow <port>[-<port>]/<tcp|udp> [--name TEXT]
    shadow-firewall remove <port>[-<port>]/<tcp|udp>
    shadow-firewall list [--json]
    shadow-firewall reload
    shadow-firewall reset

The firewall is plain nftables: /etc/nftables.conf holds the SHADOW ruleset
(default-deny inbound), and the ports the administrator opened are recorded in
/etc/shadow/firewall.json. This tool turns that record into
/etc/nftables.d/50-shadow-allowed.nft and loads it.

Safety properties:
  * a change is validated against the complete ruleset (nft --check) before it
    replaces anything, and the previous file is restored if validation fails —
    a typo can neither open the firewall nor leave it half-loaded;
  * loading replaces only the "inet shadow_filter" table, atomically; tables of
    Docker, libvirt and VPN clients are never touched;
  * "disable" removes that one table and stops it from loading at boot.

Graphical tools call this program through pkexec (polkit action
org.shadow.firewall.manage); it must run as root.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import tempfile

STATE = "/etc/shadow/firewall.json"
GENERATED = "/etc/nftables.d/50-shadow-allowed.nft"
MAIN = "/etc/nftables.conf"
TABLE = ("inet", "shadow_filter")
UNIT = "nftables.service"

PORT_RE = re.compile(r"^(\d{1,5})(?:-(\d{1,5}))?/(tcp|udp)$")
NAME_RE = re.compile(r"^[A-Za-z0-9 ._+()/-]{0,48}$")


class Failure(Exception):
    pass


def run(argv, check=True, input=None):
    env = dict(os.environ, LC_ALL="C.UTF-8", LANGUAGE="C")
    try:
        p = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, input=input, env=env)
    except FileNotFoundError:
        raise Failure(f"{argv[0]} is not installed")
    out, err = p.stdout.decode("utf-8", "replace"), p.stderr.decode("utf-8", "replace")
    if check and p.returncode != 0:
        raise Failure(f"{' '.join(argv)} failed: {(err or out).strip()}")
    return p.returncode, out, err


def parse_rule(spec):
    m = PORT_RE.match(spec)
    if not m:
        raise Failure(f"'{spec}' is not a valid rule; expected <port>/<tcp|udp> or <first>-<last>/<tcp|udp>")
    lo, hi, proto = int(m.group(1)), int(m.group(2) or m.group(1)), m.group(3)
    if not (1 <= lo <= hi <= 65535):
        raise Failure(f"'{spec}': ports must be between 1 and 65535, lowest first")
    return {"port": str(lo) if lo == hi else f"{lo}-{hi}", "protocol": proto}


def load_state():
    try:
        with open(STATE, encoding="utf-8") as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return {"version": 1, "allowed": []}
    except (OSError, json.JSONDecodeError) as exc:
        raise Failure(f"{STATE} is unreadable: {exc}")
    allowed = []
    for entry in data.get("allowed", []):
        rule = parse_rule(f"{entry.get('port')}/{entry.get('protocol')}")
        name = str(entry.get("name", ""))
        rule["name"] = name if NAME_RE.match(name) else ""
        allowed.append(rule)
    return {"version": 1, "allowed": allowed}


def save_state(state):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(STATE), prefix=".firewall.")
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(state, fh, indent=2)
        fh.write("\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, STATE)


def render(state):
    lines = ["# Generated by shadow-firewall from /etc/shadow/firewall.json — do not edit.",
             "# Change it with: shadow-firewall allow|remove <port>/<tcp|udp>"]
    for proto in ("tcp", "udp"):
        ports = [r["port"] for r in state["allowed"] if r["protocol"] == proto]
        if ports:
            lines.append(f"add element {TABLE[0]} {TABLE[1]} allowed_{proto} {{ {', '.join(ports)} }}")
    return "\n".join(lines) + "\n"


def table_loaded():
    rc, _, _ = run(["nft", "list", "table", *TABLE], check=False)
    return rc == 0


def enabled_at_boot():
    rc, out, _ = run(["systemctl", "is-enabled", UNIT], check=False)
    return out.strip() == "enabled"


def apply(state, *, load):
    """Write the generated include, validate everything, optionally load it."""
    if not os.path.exists(MAIN):
        raise Failure(f"{MAIN} is missing — reinstall the shadow-hardening package")
    os.makedirs(os.path.dirname(GENERATED), exist_ok=True)
    previous = None
    if os.path.exists(GENERATED):
        with open(GENERATED, encoding="utf-8") as fh:
            previous = fh.read()
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(GENERATED), prefix=".allowed.")
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(render(state))
    os.chmod(tmp, 0o644)
    os.replace(tmp, GENERATED)
    rc, out, err = run(["nft", "--check", "--file", MAIN], check=False)
    if rc != 0:
        if previous is None:
            os.unlink(GENERATED)
        else:
            with open(GENERATED, "w", encoding="utf-8") as fh:
                fh.write(previous)
        raise Failure("the resulting ruleset is not valid and was NOT applied:\n" + (err or out).strip())
    if load:
        run(["nft", "--file", MAIN])


def _element_text(elem):
    """One element of an inet_service set as nft --json prints it → "22" / "8000-8010"."""
    if isinstance(elem, dict) and "elem" in elem:       # element with attributes (timeout, comment…)
        elem = elem["elem"].get("val") if isinstance(elem["elem"], dict) else elem["elem"]
    if isinstance(elem, dict) and "range" in elem:
        lo, hi = elem["range"]
        return f"{lo}-{hi}"
    if isinstance(elem, (int, str)) and not isinstance(elem, bool):
        return str(elem)
    raise ValueError(f"unexpected set element {elem!r}")


def status():
    state = load_state()
    loaded = table_loaded()
    info = {
        "installed": os.path.exists(MAIN),
        "enabled_at_boot": enabled_at_boot(),
        "active": loaded,
        # The ports recorded in /etc/shadow/firewall.json (what the administrator asked for).
        "allowed": state["allowed"],
        "input_policy": None,
        "forward_policy": None,
        # Rules (statements) of the loaded "inet shadow_filter" table. Opened
        # ports are elements of the sets allowed_tcp/allowed_udp, not rules,
        # so this number does not move when a port is opened or closed — see
        # allowed_port_count for that.
        "rule_count": 0,
        "other_tables": [],
        # Entries (single ports or ranges) the kernel really has in the sets
        # allowed_tcp/allowed_udp of the loaded table; None when that cannot
        # be read (allowed_port_count_reason says why).
        "allowed_port_count": None,
        "allowed_loaded": None,
        # `nft list table inet shadow_filter` verbatim; None with ruleset_reason.
        "ruleset": None,
    }
    rc, out, err = run(["nft", "--json", "list", "ruleset"], check=False)
    if rc != 0:
        info["allowed_port_count_reason"] = (err or out).strip() or f"nft exited with status {rc}"
    else:
        loaded_ports, sets_seen = [], set()
        try:
            for item in json.loads(out).get("nftables", []):
                if "table" in item:
                    t = item["table"]
                    if (t["family"], t["name"]) != TABLE:
                        info["other_tables"].append(f"{t['family']} {t['name']}")
                elif "chain" in item:
                    c = item["chain"]
                    if (c["family"], c["table"]) == TABLE and c.get("hook"):
                        if c["hook"] == "input":
                            info["input_policy"] = c.get("policy")
                        elif c["hook"] == "forward":
                            info["forward_policy"] = c.get("policy")
                elif "rule" in item:
                    r = item["rule"]
                    if (r["family"], r["table"]) == TABLE:
                        info["rule_count"] += 1
                elif "set" in item:
                    s = item["set"]
                    if (s["family"], s["table"]) == TABLE and s["name"] in ("allowed_tcp", "allowed_udp"):
                        sets_seen.add(s["name"])
                        for elem in s.get("elem", []) or []:
                            loaded_ports.append({"port": _element_text(elem), "protocol": s["name"][-3:]})
            if not loaded:
                info["allowed_port_count_reason"] = "The firewall table is not loaded, so no port is open through it."
            elif sets_seen != {"allowed_tcp", "allowed_udp"}:
                info["allowed_port_count_reason"] = ("The loaded table has no allowed_tcp/allowed_udp sets "
                                                     "(it was not loaded from the SHADOW ruleset).")
            else:
                info["allowed_loaded"] = loaded_ports
                info["allowed_port_count"] = len(loaded_ports)
        except (json.JSONDecodeError, KeyError, TypeError, ValueError) as exc:
            info["allowed_port_count_reason"] = f"could not interpret the nft JSON output: {exc}"
    if not loaded:
        info["ruleset_reason"] = "The firewall table is not loaded."
    else:
        rc, out, err = run(["nft", "list", "table", *TABLE], check=False)
        if rc == 0:
            info["ruleset"] = out
        else:
            info["ruleset_reason"] = (err or out).strip() or f"nft exited with status {rc}"
    return info


def cmd_status(args):
    info = status()
    if args.json:
        json.dump(info, sys.stdout, indent=2)
        print()
        return 0
    print("Firewall:        " + ("active" if info["active"] else "NOT ACTIVE"))
    print("Starts at boot:  " + ("yes" if info["enabled_at_boot"] else "no"))
    if info["active"]:
        print(f"Inbound policy:  {info['input_policy']}    Forward policy: {info['forward_policy']}"
              f"    Rules: {info['rule_count']}")
    if info["allowed"]:
        print("Open ports:")
        for r in info["allowed"]:
            print(f"  {r['port']}/{r['protocol']}" + (f"   {r['name']}" if r["name"] else ""))
    else:
        print("Open ports:      none")
    if info["other_tables"]:
        print("Other nftables tables present (not managed here): " + ", ".join(info["other_tables"]))
    return 0 if info["active"] else 3


def cmd_list(args):
    state = load_state()
    if args.json:
        json.dump(state["allowed"], sys.stdout, indent=2)
        print()
    else:
        for r in state["allowed"]:
            print(f"{r['port']}/{r['protocol']}" + (f"\t{r['name']}" if r["name"] else ""))
    return 0


def cmd_enable(_args):
    apply(load_state(), load=True)
    run(["systemctl", "enable", UNIT])
    if not table_loaded():
        raise Failure("the ruleset was loaded but the table is not present")
    print("Firewall enabled.")
    return 0


def cmd_disable(_args):
    run(["systemctl", "disable", UNIT])
    if table_loaded():
        run(["nft", "delete", "table", *TABLE])
    print("Firewall disabled: inbound connections are no longer filtered.")
    return 0


def cmd_allow(args):
    rule = parse_rule(args.rule)
    name = args.name or ""
    if not NAME_RE.match(name):
        raise Failure("--name may contain letters, digits, spaces and . _ + ( ) / - (at most 48 characters)")
    rule["name"] = name
    state = load_state()
    state["allowed"] = [r for r in state["allowed"]
                        if (r["port"], r["protocol"]) != (rule["port"], rule["protocol"])] + [rule]
    apply(state, load=table_loaded())
    save_state(state)
    print(f"Allowed inbound {rule['port']}/{rule['protocol']}.")
    return 0


def cmd_remove(args):
    rule = parse_rule(args.rule)
    state = load_state()
    kept = [r for r in state["allowed"] if (r["port"], r["protocol"]) != (rule["port"], rule["protocol"])]
    if len(kept) == len(state["allowed"]):
        raise Failure(f"{rule['port']}/{rule['protocol']} is not in the list of open ports")
    state["allowed"] = kept
    apply(state, load=table_loaded())
    save_state(state)
    print(f"Closed inbound {rule['port']}/{rule['protocol']}.")
    return 0


def cmd_reload(_args):
    apply(load_state(), load=True)
    print("Firewall rules reloaded.")
    return 0


def cmd_reset(_args):
    state = {"version": 1, "allowed": []}
    apply(state, load=table_loaded())
    save_state(state)
    print("All opened ports were closed.")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="shadow-firewall", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", required=True)
    p = sub.add_parser("status"); p.add_argument("--json", action="store_true"); p.set_defaults(func=cmd_status)
    p = sub.add_parser("list"); p.add_argument("--json", action="store_true"); p.set_defaults(func=cmd_list)
    sub.add_parser("enable").set_defaults(func=cmd_enable)
    sub.add_parser("disable").set_defaults(func=cmd_disable)
    p = sub.add_parser("allow"); p.add_argument("rule"); p.add_argument("--name"); p.set_defaults(func=cmd_allow)
    p = sub.add_parser("remove"); p.add_argument("rule"); p.set_defaults(func=cmd_remove)
    sub.add_parser("reload").set_defaults(func=cmd_reload)
    sub.add_parser("reset").set_defaults(func=cmd_reset)
    args = ap.parse_args()
    if os.geteuid() != 0:
        print("shadow-firewall: must run as root (use sudo, or the Control Center)", file=sys.stderr)
        return 1
    try:
        return args.func(args)
    except Failure as exc:
        print(f"shadow-firewall: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
