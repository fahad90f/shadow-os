<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Shadow OS</vendor>
  <vendor_url>https://github.com/fahad90fa/Custom-OS</vendor_url>

  <!--
    Read-only security report (shadow-security-status). It takes no input other
    than section names and changes nothing, so a person sitting at the machine
    may run it without a password prompt. Remote and inactive sessions may not:
    the report reveals listening services and login activity.
  -->
  <action id="org.shadow.security.read-status">
    <description>Read the security status of this computer</description>
    <message>Authentication is required to read the security status of this computer</message>
    <icon_name>org.shadow.securitycenter</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/sbin/shadow-security-status</annotate>
  </action>

  <!-- Changing the firewall always requires an administrator. -->
  <action id="org.shadow.firewall.manage">
    <description>Change the firewall configuration</description>
    <message>Authentication is required to change the firewall</message>
    <icon_name>org.shadow.securitycenter</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/sbin/shadow-firewall</annotate>
  </action>
</policyconfig>
