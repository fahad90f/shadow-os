# Boot chain. The *-bin and *-signed packages only ship files under /usr/lib;
# nothing here writes to a disk at package-install time. Installing GRUB to a
# disk and keeping it current afterwards is the job of the shadow-boot package
# (system/boot/shadow-boot), which replaces Debian's grub-pc/grub-efi-* front-ends.

grub-common
grub2-common
efibootmgr
os-prober
mokutil

# Snapshots and rollback for btrfs installs (opt-in in the installer). Inert on
# ext4 installs; shadow-snapshots-setup only configures it when / is btrfs.
# (grub-btrfs, which adds snapshots to the boot menu, is not packaged in
# Debian; rollback is "snapper undochange" instead.)
snapper

# UEFI x86_64 — Microsoft-signed shim + Debian-signed GRUB (Secure Boot)
shim-signed [amd64]
grub-efi-amd64-bin [amd64]
grub-efi-amd64-signed [amd64]
# Legacy BIOS x86_64
grub-pc-bin [amd64]

# UEFI AArch64
shim-signed [arm64]
grub-efi-arm64-bin [arm64]
grub-efi-arm64-signed [arm64]
