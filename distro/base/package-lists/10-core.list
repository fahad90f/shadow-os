# Core operating system: init, kernel, storage, base utilities.
# Syntax: one package per line; "[arch ...]" restricts a line to those
# Debian architectures; '#' starts a comment.

# init / service management
systemd
systemd-sysv
systemd-timesyncd
libpam-systemd
libnss-systemd
dbus
dbus-user-session
udev
kmod

# kernel (Debian-signed; boots under Secure Boot without key enrolment)
linux-image-amd64 [amd64]
linux-image-arm64 [arm64]
initramfs-tools
zstd

# authentication / privilege
sudo
polkitd
pkexec
libpam-modules
passwd
adduser

# locale / console
locales
console-setup
keyboard-configuration
kbd
tzdata

