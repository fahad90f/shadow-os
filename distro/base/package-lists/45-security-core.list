# Shadow OS always-on privacy and security core. The full offensive/defensive
# toolkit is installed on demand through Shadow Arsenal (or in full by the
# complete-arsenal metapackage); these are the everyday privacy and crypto
# tools every Shadow OS install carries.

# Anonymity and tunnelling
tor
torsocks
proxychains4

# VPN
wireguard-tools
openvpn
network-manager-openvpn
network-manager-openvpn-gnome

# The system resolver: encrypted DNS (DNS-over-TLS, DNSSEC), no LLMNR and no
# multicast DNS - all configured by shadow-hardening. Only in images that
# install shadow-hardening: with Debian's own settings it answers its host
# name over LLMNR on every network and sends DNS in plain text (the minimal
# image therefore has no resolved; NetworkManager writes /etc/resolv.conf).
# Also provides the resolvconf command that wg-quick and OpenVPN scripts
# call. Its Recommends (libnss-resolve, libnss-myhostname) are not
# installed: nsswitch stays "files dns", so every lookup goes through
# /etc/resolv.conf (docs/security/private-dns.md).
systemd-resolved

# Encryption, secrets, secure comms
keepassxc
gnupg
openssl
age
cryptsetup

# Privacy utilities
macchanger
steghide
libimage-exiftool-perl
secure-delete

# Encrypted backups (shadow-backup wraps this)
restic

# Extra confinement profiles for the hardened baseline
apparmor-profiles-extra

# Privilege-escalation helper that Lynis (and desktop menus) look for:
# provides /usr/bin/su-to-root. Its absence makes "lynis audit system" warn
# "cannot find a program su-to-root".
menu
