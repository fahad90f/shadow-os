# Shadow Horizon desktop: the Debian packages behind the session. SHADOW's own
# packages (shell, applications, themes) are listed in the variant file.

# Boot splash (also asks for the disk-encryption passphrase)
plymouth
plymouth-label

# Display manager and session plumbing
sddm
dbus-user-session
libpam-systemd
polkitd
pkexec
rtkit
xdg-user-dirs
xdg-utils
xdg-desktop-portal
xdg-desktop-portal-kde
xdg-desktop-portal-gtk
# The KDE portal's dialogs (the screen-sharing picker, screenshot and access
# prompts) are QML that imports org.kde.plasma.workspace.dialogs and
# org.kde.taskmanager, which only plasma-workspace ships; without it every
# screen share is silently cancelled. It is there for those modules: Shadow
# starts no Plasma session (also a dependency of shadow-horizon; listed for
# clarity).
plasma-workspace
# The picker's live previews (PipeWireDelegate.qml imports org.kde.pipewire);
# the portal itself does not depend on it. The libraries come with it and are
# listed for clarity. Whether the portal offers ScreenCast at all depends on
# XDG_CURRENT_DESKTOP (desktop/horizon-shell/session/plasma-xdg-desktop-portal-kde.conf).
libkpipewire6
libkpipewire-data
libkpipewiredmabuf6
libkpipewirerecord6
qml6-module-org-kde-pipewire

# Compositor (pulled in by shadow-horizon as well; listed for clarity)
kwin-wayland
# Window switcher (Alt+Tab) support, the scripted window animations, screen
# casting and the other KWin plug-ins; kwin-wayland alone has none of them.
kwin-common
xwayland
# Opening web links from applications: xdg-open hands links to kde-open in the
# Shadow session (kde-cli-tools); browsers make themselves the default with
# kwriteconfig6 (libkf6config-bin); applications register the links they
# handle (claude://, vscode://…) with update-desktop-database.
kde-cli-tools
libkf6config-bin
desktop-file-utils
plasma-desktoptheme

# Graphics: Mesa for Intel, AMD, Nouveau, virtual GPUs and software rendering
libgl1-mesa-dri
libegl-mesa0
libgbm1
mesa-vulkan-drivers
mesa-va-drivers
libglx-mesa0

# Audio
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
alsa-utils

# Voice of the Shadow Assistant (hands-free "Shadow", spoken replies). Its
# engine, shadow-voiced (package shadow-assistant), runs entirely offline from
# /var/lib/shadow-voice, which the image build fills with the pinned neural
# models (build/iso/voice-data.sh, ~700 MB, sha256-checked); on a system
# without them: sudo shadow-voice-setup --system. The Debian side of it
# (shadow-assistant depends on all of these except alsa-ucm-conf; listed for
# clarity):
#   python3-numpy  — the engine's array maths (otherwise shadow-voice-setup has
#                    to add a pinned numpy wheel).
#   espeak-ng      — pronounces words missing from the voice's lexicon, and is
#                    the "basic voice" while the neural engine is not installed.
#   pipewire-bin   — pw-record / pw-play: microphone capture and playback (also
#                    pulled in by pipewire).
#   alsa-ucm-conf  — ALSA use-case profiles. Laptops whose microphones are a
#                    digital array behind the audio DSP (Intel SOF "DMIC", e.g.
#                    Comet Lake and newer) show no microphone at all without
#                    them. Only a Recommends of libasound2-data, so it must be
#                    listed. The DSP firmware itself is firmware-sof-signed
#                    (15-firmware.list).
# pocketsphinx and speech-dispatcher are no longer used: trixie's pocketsphinx
# is 0.8+5prealpha with 2015 models and no acoustic model at all unless the
# pocketsphinx-en-us Recommends is installed; speech-dispatcher without its
# espeak-ng module made every spoken reply hang for about 30 seconds.
python3-numpy
espeak-ng
pipewire-bin
alsa-ucm-conf

# Networking, Bluetooth, power, storage services used by the desktop
network-manager
wpasupplicant
wireless-regdb
iw
bluez
upower
power-profiles-daemon
udisks2
accountsservice
packagekit
appstream
fwupd

# Fonts
fonts-inter-variable
fonts-jetbrains-mono
fonts-noto-core
fonts-noto-color-emoji
fonts-noto-mono

# Everyday applications that are not SHADOW's own
firefox-esr

# Tools the SHADOW applications call
traceroute
bind9-dnsutils
tcpdump
libkscreen-bin
pulseaudio-utils
os-prober
exfatprogs
ntfs-3g
btrfs-progs
smartmontools
kio-extras
