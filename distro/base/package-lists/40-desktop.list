# Shadow Horizon desktop: the Debian packages behind the session. SHADOW's own
# packages (shell, applications, themes) are listed in the variant file.

# Boot splash (also asks for the disk-encryption passphrase)
plymouth
plymouth-label

# Display manager and session plumbing
sddm
dbus-user-session
libpam-systemd
polkitd
pkexec
rtkit
xdg-user-dirs
xdg-utils
xdg-desktop-portal
xdg-desktop-portal-kde
xdg-desktop-portal-gtk

# Compositor (pulled in by shadow-horizon as well; listed for clarity)
kwin-wayland
# Window switcher (Alt+Tab) support, the scripted window animations, screen
# casting and the other KWin plug-ins; kwin-wayland alone has none of them.
kwin-common
xwayland
# Opening web links from applications: xdg-open hands links to kde-open in the
# Shadow session (kde-cli-tools); browsers make themselves the default with
# kwriteconfig6 (libkf6config-bin); applications register the links they
# handle (claude://, vscode://…) with update-desktop-database.
kde-cli-tools
libkf6config-bin
desktop-file-utils
plasma-desktoptheme

# Graphics: Mesa for Intel, AMD, Nouveau, virtual GPUs and software rendering
libgl1-mesa-dri
libegl-mesa0
libgbm1
mesa-vulkan-drivers
mesa-va-drivers
libglx-mesa0

# Audio
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
alsa-utils

# Networking, Bluetooth, power, storage services used by the desktop
network-manager
wpasupplicant
wireless-regdb
iw
bluez
upower
power-profiles-daemon
udisks2
accountsservice
packagekit
appstream
fwupd

# Fonts
fonts-inter-variable
fonts-jetbrains-mono
fonts-noto-core
fonts-noto-color-emoji
fonts-noto-mono

# Everyday applications that are not SHADOW's own
firefox-esr

# Tools the SHADOW applications call
traceroute
bind9-dnsutils
tcpdump
libkscreen-bin
pulseaudio-utils
os-prober
exfatprogs
ntfs-3g
btrfs-progs
smartmontools
kio-extras
