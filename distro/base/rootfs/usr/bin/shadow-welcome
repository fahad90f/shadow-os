#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""shadow-welcome — first-run setup for Shadow OS.

Runs once, the first time you log in. It checks the hardware the live/installed
session most often has trouble with (network, graphics, sound), lets you choose
how strict the system should be, and helps you set up encrypted backups. After
it finishes it marks itself done and does not open again.

  shadow-welcome              run the welcome flow
  shadow-welcome --autostart  run it only if it has not been completed (used by
                              the autostart entry; exits silently otherwise)
  shadow-welcome --reset      forget that it ran, so it opens next login
"""
import os
import shutil
import subprocess
import sys
from pathlib import Path

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "shadow"
DONE = CONFIG_DIR / "welcome-done"

C_TITLE = "\033[1;36m"
C_OK    = "\033[1;32m"
C_WARN  = "\033[1;33m"
C_DIM   = "\033[2m"
C_OFF   = "\033[0m"


def sh(cmd):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        return r.returncode, r.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""


def have(prog):
    return shutil.which(prog) is not None


def ask(prompt, default="n"):
    try:
        a = input(prompt).strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    if not a:
        a = default
    return a.startswith("y")


def hardware_check():
    print(f"\n{C_TITLE}1. Hardware{C_OFF}")

    # Network
    if have("nmcli"):
        rc, out = sh(["nmcli", "-t", "-f", "TYPE,STATE", "device"])
        online = any(line.endswith(":connected") for line in out.splitlines())
        wifi = any(line.startswith("wifi:") for line in out.splitlines())
        print(f"   Network   : {C_OK}connected{C_OFF}" if online
              else f"   Network   : {C_WARN}not connected — open the network menu to join Wi-Fi{C_OFF}")
        if wifi:
            print(f"   Wi-Fi     : {C_OK}adapter detected{C_OFF}")
        else:
            print(f"   Wi-Fi     : {C_DIM}no wireless adapter seen{C_OFF}")
    else:
        print(f"   Network   : {C_DIM}nmcli not available{C_OFF}")

    # Graphics
    rc, out = sh(["sh", "-c", "lspci | grep -iE 'vga|3d|display'"])
    if rc == 0 and out:
        gpu = out.splitlines()[0].split(": ", 1)[-1]
        print(f"   Graphics  : {C_OK}{gpu[:60]}{C_OFF}")
        sess = os.environ.get("XDG_SESSION_TYPE", "")
        if sess:
            print(f"   Session   : {sess}")
    else:
        print(f"   Graphics  : {C_DIM}could not detect a GPU{C_OFF}")

    # Sound
    if have("pactl"):
        rc, out = sh(["pactl", "list", "short", "sinks"])
        if rc == 0 and out:
            print(f"   Sound     : {C_OK}output device present{C_OFF}")
        else:
            print(f"   Sound     : {C_WARN}no output device — check the audio settings{C_OFF}")
    else:
        print(f"   Sound     : {C_DIM}pactl not available{C_OFF}")


def hardening_step():
    print(f"\n{C_TITLE}2. Security level{C_OFF}")
    if not have("shadow-harden"):
        print(f"   {C_DIM}shadow-harden not installed; skipping.{C_OFF}")
        return
    rc, out = sh(["shadow-harden", "level"])
    for line in out.splitlines():
        if line.strip():
            print("   " + line)
    print("\n   Choose: [1] Standard   [2] Hardened (default)   [3] Paranoid   [Enter] keep current")
    try:
        choice = input("   > ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return
    level = {"1": "standard", "2": "hardened", "3": "paranoid"}.get(choice)
    if not level:
        print(f"   {C_DIM}kept current level.{C_OFF}")
        return
    print(f"   Applying '{level}' (you may be asked for your password)…")
    subprocess.run(["pkexec", "shadow-harden", "level", level], check=False)


def backup_step():
    print(f"\n{C_TITLE}3. Encrypted backups{C_OFF}")
    if not have("shadow-backup"):
        print(f"   {C_DIM}shadow-backup not installed; skipping.{C_OFF}")
        return
    if (CONFIG_DIR / "backup.conf").exists():
        print(f"   {C_OK}Already set up. Run 'shadow-backup run' to back up.{C_OFF}")
        return
    print("   Keep a copy of your files, encrypted, on a drive you choose.")
    if not ask("   Set this up now? Plug in a drive first. [y/N] "):
        print(f"   {C_DIM}Skipped. Set it up later with: shadow-backup setup <drive>{C_OFF}")
        return
    try:
        target = input("   Path to the drive (e.g. /media/you/USB): ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return
    if target:
        subprocess.run(["shadow-backup", "setup", target], check=False)


def run():
    print(f"{C_TITLE}╔════════════════════════════════════════════╗{C_OFF}")
    print(f"{C_TITLE}║        Welcome to Shadow OS                ║{C_OFF}")
    print(f"{C_TITLE}╚════════════════════════════════════════════╝{C_OFF}")
    print("A quick first-run setup. You can re-run it any time with: shadow-welcome")

    hardware_check()
    hardening_step()
    backup_step()

    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    DONE.write_text("done\n")
    print(f"\n{C_OK}All set.{C_OFF} This will not open again automatically.")
    print(f"{C_DIM}Press Enter to close.{C_OFF}")
    try:
        input()
    except (EOFError, KeyboardInterrupt):
        pass


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--reset":
        DONE.unlink(missing_ok=True)
        print("shadow-welcome will open on next login.")
        return
    if arg == "--autostart" and DONE.exists():
        return  # already completed; stay quiet
    if arg in ("-h", "--help"):
        print(__doc__)
        return
    run()


if __name__ == "__main__":
    main()
