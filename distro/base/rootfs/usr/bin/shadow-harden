#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""shadow-harden — OS integrity and kernel hardening management for Shadow OS.

Must be called as root (enforced). Invoked via pkexec from the Control Center.

Usage: shadow-harden <command>

Commands:
  status            Print current hardening state as JSON.
  aide-init         Initialise (or rebuild) the AIDE file-integrity database.
  aide-check        Run an AIDE integrity check; report changes.
  enforce-apparmor  Put all AppArmor profiles into enforce mode.
  boot-harden       Write 24 kernel boot parameters to GRUB; run update-grub.
  fs-harden         Remount /proc (hidepid=2; the group "proc", which polkitd
                    joins, still sees every process), /tmp and /dev/shm
                    (noexec+nosuid+nodev). The kernel parameter
                    shadow.hidepid=off skips the /proc part at boot.
  migrate-hidepid [--offline]
                    Used by the package (postinst): rewrite a
                    proc-shadow-hidepid.service of an older version (hidepid=2
                    without the group, which broke pkexec at every start) the
                    way fs-harden writes it now, and give /proc the group now.
                    Nothing else of fs-harden. --offline (a chroot): the files
                    only. Without the group, the unit is disabled instead.
  level [NAME]      Show, or set to NAME, the hardening level
                    (standard | hardened | paranoid). With no NAME, prints the
                    current level and what each one changes.
"""

import sys
import os
import grp
import json
import pwd
import subprocess
import shutil
import datetime
from pathlib import Path

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

STATE_FILE   = Path("/run/shadow-harden-state.json")
AIDE_DB      = Path("/var/lib/aide/aide.db")
AIDE_DB_NEW  = Path("/var/lib/aide/aide.db.new")
AIDE_LOG     = Path("/var/log/shadow-harden-aide.log")
GRUB_DIR     = Path("/etc/default/grub.d")
GRUB_CFG     = GRUB_DIR / "90-shadow-hardening.cfg"
AUDIT_RULES  = Path("/etc/audit/rules.d/90-shadow-audit.rules")
POLKIT_RULE  = Path("/etc/polkit-1/rules.d/50-shadow-harden.rules")

# /proc with hidepid=2 hides other users' processes. polkitd runs as its own
# unprivileged user and must read /proc/<pid> of every process that asks for
# an authorisation; without access, pkexec and every polkit-checked action
# fail. Members of PROC_GROUP (gid= mount option) still see every process,
# so polkitd is added to it.
PROC_GROUP     = "proc"
POLKIT_USER    = "polkitd"
POLKIT_UNIT    = "polkit.service"
HIDEPID_UNIT   = Path("/etc/systemd/system/proc-shadow-hidepid.service")
HIDEPID_ESCAPE = "shadow.hidepid=off"
MOUNTINFO      = Path("/proc/self/mountinfo")
FSTAB          = Path("/etc/fstab")

# Hardening levels. These sysctl keys trade compatibility for security, so they
# are chosen here rather than fixed in 91-shadow-extreme.conf. The level file is
# numbered 99 so it wins over 90/91. "standard" keeps every common desktop app
# working; "hardened" (the default) is safe for a normal desktop too, because it
# leaves unprivileged user namespaces ON so browser and Flatpak sandboxes work;
# "paranoid" turns user namespaces OFF, which breaks those sandboxes.
LEVEL_FILE   = Path("/etc/sysctl.d/99-shadow-level.conf")
LEVEL_MARKER = Path("/etc/shadow-os/hardening-level")
LEVEL_ORDER  = ("standard", "hardened", "paranoid")
DEFAULT_LEVEL = "hardened"

LEVELS = {
    "standard": {
        "kernel.unprivileged_userns_clone": "1",   # browsers, Flatpak, containers
        # Trixie also gates userns behind AppArmor; 0 lets Electron/Chromium
        # (browsers, VSCodium, Discord, Vesktop) use their namespace sandbox
        # instead of the setuid one. Without it the SUID chrome-sandbox path is
        # used and apps abort unless chrome-sandbox is manually setuid-root.
        "kernel.apparmor_restrict_unprivileged_userns": "0",
        "kernel.unprivileged_bpf_disabled": "0",   # profilers/tracers work
        "kernel.perf_event_paranoid":       "2",   # perf for non-root (limited)
    },
    "hardened": {
        "kernel.unprivileged_userns_clone": "1",   # kept ON so sandboxes work
        "kernel.apparmor_restrict_unprivileged_userns": "0",  # ↑ Electron/browser sandboxes
        "kernel.unprivileged_bpf_disabled": "1",   # no unprivileged BPF
        "kernel.perf_event_paranoid":       "3",   # perf root-only
    },
    "paranoid": {
        "kernel.unprivileged_userns_clone": "0",   # BREAKS browser/Flatpak sandboxes
        "kernel.apparmor_restrict_unprivileged_userns": "1",  # fully restrict userns too
        "kernel.unprivileged_bpf_disabled": "2",   # BPF fully off
        "kernel.perf_event_paranoid":       "4",   # perf fully off
    },
}

LEVEL_NOTES = {
    "standard": "Everyday desktop. Core protections on; nothing that commonly breaks apps.",
    "hardened": "Default. Stronger limits, but keeps browser and Flatpak sandboxes working.",
    "paranoid": "Maximum. Disables unprivileged user namespaces — web-browser and Flatpak "
                "sandboxes, and most container tools, will not work.",
}

BOOT_PARAMS = (
    "slab_nomerge "
    "init_on_alloc=1 "
    "init_on_free=1 "
    "page_alloc.shuffle=1 "
    "pti=on "
    "spectre_v2=on "
    "spec_store_bypass_disable=on "
    "l1tf=full,force "
    "mds=full "
    "tsx=off "
    "tsx_async_abort=full,nosmt "
    "kvm.nx_huge_pages=force "
    "randomize_kstack_offset=on "
    "vsyscall=none "
    "debugfs=off "
    "oops=panic "
    "module.sig_enforce=1 "
    "lockdown=confidentiality "
    "iommu=force "
    "intel_iommu=on "
    "amd_iommu=on "
    "efi=disable_early_pci_dma "
    "random.trust_cpu=off "
    "random.trust_bootloader=off"
)

# ---------------------------------------------------------------------------
# State helpers
# ---------------------------------------------------------------------------

def load_state() -> dict:
    try:
        return json.loads(STATE_FILE.read_text())
    except Exception:
        return {}


def save_state(s: dict) -> None:
    STATE_FILE.write_text(json.dumps(s, indent=2))


def _now() -> str:
    return datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")


def _run(argv):
    """Run a program without a shell; (returncode, combined output). 127: not installed."""
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=60)
    except FileNotFoundError:
        return 127, f"{argv[0]} is not installed"
    except subprocess.TimeoutExpired:
        return 124, f"{argv[0]} did not finish within 60 s"
    return r.returncode, (r.stderr or r.stdout).strip()


def render_hidepid_unit(gid: int) -> str:
    """proc-shadow-hidepid.service: hidepid=2 at every boot, group gid sees all."""
    return (
        "# Written by `shadow-harden fs-harden`; run it again rather than editing.\n"
        "# hidepid=2 hides other users' processes; members of the group with\n"
        f"# gid {gid} ({PROC_GROUP}, which polkitd joins) still see all of them.\n"
        f"# The kernel parameter {HIDEPID_ESCAPE} skips it for one boot.\n"
        "[Unit]\n"
        "Description=Shadow OS: remount /proc with hidepid=2\n"
        "After=systemd-remount-fs.service\n"
        "DefaultDependencies=no\n"
        f"ConditionKernelCommandLine=!{HIDEPID_ESCAPE}\n\n"
        "[Service]\n"
        "Type=oneshot\n"
        f"ExecStart=/bin/mount -o remount,hidepid=2,gid={gid} /proc\n"
        "RemainAfterExit=yes\n\n"
        "[Install]\n"
        "WantedBy=sysinit.target\n"
    )


def proc_mount_state(mountinfo_text: str) -> dict:
    """hidepid mode and gid of the /proc mount, from /proc/self/mountinfo."""
    state = {"mounted": False, "hidepid": "off", "gid": None}
    for line in mountinfo_text.splitlines():
        fields = line.split()
        if len(fields) < 5 or fields[4] != "/proc" or " - proc " not in line:
            continue
        state["mounted"] = True
        options = line.split(" - ", 1)[1].split()
        opts = options[2].split(",") if len(options) > 2 else []
        for opt in opts:
            key, _, value = opt.partition("=")
            if key == "hidepid":
                state["hidepid"] = {"0": "off", "1": "noaccess", "2": "invisible",
                                    "4": "ptraceable"}.get(value, value)
            elif key == "gid" and value.isdigit():
                state["gid"] = int(value)
    return state


def hidepid_status() -> dict:
    """What /proc looks like now, and whether polkitd can still see processes."""
    try:
        state = proc_mount_state(MOUNTINFO.read_text())
    except OSError:
        state = {"mounted": False, "hidepid": "unknown", "gid": None}
    try:
        group = grp.getgrnam(PROC_GROUP)
        state["group"] = PROC_GROUP
        state["group_gid"] = group.gr_gid
        state["polkitd_in_group"] = POLKIT_USER in group.gr_mem
    except KeyError:
        state["group"] = None
        state["group_gid"] = None
        state["polkitd_in_group"] = False
    # pkexec keeps working when nothing is hidden, or polkitd is in the gid= group.
    state["polkit_can_see_processes"] = (
        state["hidepid"] == "off"
        or (state["gid"] is not None and state["gid"] == state["group_gid"] and state["polkitd_in_group"]))
    return state


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def cmd_status() -> None:
    """Print hardening status as JSON."""
    s = load_state()

    # Cross-check on-disk evidence (survives reboots that clear /run)
    s["aide_initialized"] = AIDE_DB.exists()

    # AppArmor
    try:
        r = subprocess.run(
            ["aa-status", "--json"],
            capture_output=True, text=True, timeout=5
        )
        if r.returncode == 0:
            aa = json.loads(r.stdout)
            enforcing = int(aa.get("profiles", {}).get("enforce", 0))
            s["apparmor_enforcing"] = enforcing > 0
        else:
            s["apparmor_enforcing"] = False
    except Exception:
        s["apparmor_enforcing"] = False

    # auditd
    try:
        r = subprocess.run(
            ["systemctl", "is-active", "auditd"],
            capture_output=True, text=True, timeout=5
        )
        s["auditd_running"] = r.stdout.strip() == "active"
    except Exception:
        s["auditd_running"] = False

    # Boot hardening
    s["boot_hardened"] = GRUB_CFG.exists()

    # /proc hidepid (fs-harden): what is mounted now, not what was asked for.
    s["proc_hidepid"] = hidepid_status()

    # Hardening level
    s["hardening_level"] = current_level()

    print(json.dumps(s, indent=2))


def cmd_aide_init() -> None:
    """Initialise or rebuild the AIDE file-integrity database."""
    if not shutil.which("aide"):
        print("Installing aide…")
        subprocess.run(
            ["apt-get", "install", "-y", "--no-install-recommends", "aide"],
            check=True
        )

    print("Initialising AIDE database — this may take 2–10 minutes…")
    sys.stdout.flush()

    r = subprocess.run(["aide", "--init"], capture_output=False)
    if r.returncode not in (0, 1):  # aide --init returns 1 when rules reference missing paths
        print(f"aide --init exited with code {r.returncode}. Check aide output above.", file=sys.stderr)
        sys.exit(r.returncode)

    # Move new database into production location
    if AIDE_DB_NEW.exists():
        AIDE_DB_NEW.rename(AIDE_DB)
        print(f"Database written to {AIDE_DB}.")
    elif AIDE_DB.exists():
        print("Database already in place.")
    else:
        print("Warning: aide.db not found after init; check aide configuration.", file=sys.stderr)

    s = load_state()
    s["aide_initialized"] = True
    s["aide_init_time"] = _now()
    s["aide_last_check"] = ""
    s["aide_changes"] = 0
    save_state(s)
    print("AIDE database initialised.")


def cmd_aide_check() -> None:
    """Run an AIDE integrity check and report any changes."""
    if not AIDE_DB.exists():
        print("AIDE database not found. Run aide-init first.", file=sys.stderr)
        sys.exit(1)

    print("Running AIDE integrity check…")
    sys.stdout.flush()

    r = subprocess.run(["aide", "--check"], capture_output=True, text=True)
    output = r.stdout + r.stderr

    # aide returns: 0=ok, 1=new/changed/removed files found, 2+=error
    changes = 0
    if r.returncode == 1:
        # Count changed/added/removed entries
        changes = sum(
            1 for line in output.splitlines()
            if line.startswith(("changed:", "added:", "removed:"))
        )
        print(f"WARNING: {changes} change(s) detected!")
        # Print first 4000 chars of output
        print(output[:4000])
    elif r.returncode == 0:
        print("Integrity check passed. No changes detected.")
    else:
        print(f"AIDE error (exit {r.returncode}):", file=sys.stderr)
        print(output[:2000], file=sys.stderr)

    # Write full log
    AIDE_LOG.parent.mkdir(parents=True, exist_ok=True)
    AIDE_LOG.write_text(output)

    s = load_state()
    s["aide_last_check"] = _now()
    s["aide_changes"] = changes
    save_state(s)

    if r.returncode > 1:
        sys.exit(r.returncode)


def cmd_enforce_apparmor() -> None:
    """Enable AppArmor and put all profiles into enforce mode."""
    if not shutil.which("aa-enforce"):
        print("Installing apparmor-utils…")
        subprocess.run(
            ["apt-get", "install", "-y", "--no-install-recommends",
             "apparmor", "apparmor-utils", "apparmor-profiles"],
            check=True
        )

    # Enable the service
    subprocess.run(["systemctl", "enable", "--now", "apparmor"], check=False)

    # Enforce all profiles in the profiles directory
    profiles_dir = Path("/etc/apparmor.d")
    if profiles_dir.exists():
        r = subprocess.run(
            ["aa-enforce", str(profiles_dir)],
            capture_output=True, text=True
        )
        if r.stdout:
            print(r.stdout)
        if r.stderr:
            print(r.stderr)
    else:
        print("No profiles directory found at /etc/apparmor.d.", file=sys.stderr)

    s = load_state()
    s["apparmor_enforcing"] = True
    save_state(s)
    print("AppArmor profiles set to enforce mode.")


def cmd_boot_harden() -> None:
    """Write hardened kernel boot parameters to GRUB configuration."""
    GRUB_DIR.mkdir(parents=True, exist_ok=True)

    cfg_content = (
        "# Shadow OS — extreme kernel boot hardening.\n"
        "# Written by shadow-harden boot-harden.\n"
        "# To revert: delete this file and run update-grub.\n"
        "#\n"
        "# Parameters applied:\n"
        "#   slab_nomerge              — prevent heap exploitation via slab merging\n"
        "#   init_on_alloc/free=1      — zero memory on alloc and free (defeats uninit-read)\n"
        "#   page_alloc.shuffle=1      — randomise page-allocator freelists\n"
        "#   pti=on                    — Page Table Isolation (Meltdown)\n"
        "#   spectre_v2=on             — Spectre variant 2 mitigations\n"
        "#   spec_store_bypass_disable — Speculative Store Bypass (Spectre v4)\n"
        "#   l1tf=full,force           — L1 Terminal Fault (Foreshadow)\n"
        "#   mds=full                  — Microarchitectural Data Sampling\n"
        "#   tsx=off tsx_async_abort   — Transactional Sync Extensions attacks\n"
        "#   kvm.nx_huge_pages=force   — iTLB multihit mitigation\n"
        "#   randomize_kstack_offset   — randomise per-syscall kernel stack offset\n"
        "#   vsyscall=none             — disable legacy vsyscall interface\n"
        "#   debugfs=off               — close debugfs information leaks\n"
        "#   oops=panic                — panic on kernel oops (harder to exploit)\n"
        "#   module.sig_enforce=1      — only load signed kernel modules\n"
        "#   lockdown=confidentiality  — kernel lockdown LSM\n"
        "#   iommu=force               — IOMMU (prevents DMA attacks from PCIe)\n"
        "#   intel_iommu/amd_iommu     — vendor IOMMU drivers\n"
        "#   efi=disable_early_pci_dma — block PCIe DMA before IOMMU is ready\n"
        "#   random.trust_cpu/boot=off — do not trust CPU/bootloader RNG alone\n"
        "#\n"
        f'GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT {BOOT_PARAMS}"\n'
    )

    GRUB_CFG.write_text(cfg_content)
    print(f"Wrote {GRUB_CFG}")

    # Regenerate GRUB config
    if shutil.which("update-grub"):
        print("Running update-grub…")
        r = subprocess.run(["update-grub"], capture_output=True, text=True)
        if r.returncode == 0:
            print("update-grub succeeded.")
        else:
            print(f"update-grub exited {r.returncode}: {r.stderr.strip()}", file=sys.stderr)
    else:
        print("update-grub not found; regenerate GRUB manually.", file=sys.stderr)

    s = load_state()
    s["boot_hardened"] = True
    s["boot_harden_pending_reboot"] = True
    save_state(s)
    print("Boot hardening applied. A reboot is required to activate all parameters.")


def ensure_proc_group(live: bool = True) -> tuple:
    """The PROC_GROUP gid, with polkitd as a member (and polkit restarted so it
    has the group; not with live=False, in a chroot). Returns (gid, problem);
    problem is None when all is well."""
    try:
        gid = grp.getgrnam(PROC_GROUP).gr_gid
    except KeyError:
        rc, out = _run(["groupadd", "--system", PROC_GROUP])
        if rc != 0:
            return None, f"could not create the group {PROC_GROUP}: {out}"
        try:
            gid = grp.getgrnam(PROC_GROUP).gr_gid
        except KeyError:
            return None, f"the group {PROC_GROUP} does not exist after groupadd"
        print(f"  Created the system group {PROC_GROUP} (gid {gid}).")
    try:
        pwd.getpwnam(POLKIT_USER)
    except KeyError:
        print(f"  Note: no user {POLKIT_USER} (polkit is not installed); nothing to add to {PROC_GROUP}.")
        return gid, None
    if POLKIT_USER not in grp.getgrnam(PROC_GROUP).gr_mem:
        rc, out = _run(["gpasswd", "-a", POLKIT_USER, PROC_GROUP])
        if rc != 0:
            return gid, f"could not add {POLKIT_USER} to the group {PROC_GROUP}: {out}"
        print(f"  Added {POLKIT_USER} to the group {PROC_GROUP}.")
        if not live:
            return gid, None
        # A running polkitd keeps the groups it started with.
        rc, out = _run(["systemctl", "try-restart", POLKIT_UNIT])
        if rc != 0:
            return gid, f"could not restart {POLKIT_UNIT} so that it joins {PROC_GROUP}: {out}"
    return gid, None


def cmd_fs_harden() -> None:
    """Remount filesystems with strict options and make persistent."""
    problems = []

    # /proc: only once polkitd can still see the processes it authorises,
    # otherwise pkexec (and every Shadow tool started through it) stops working.
    gid, problem = ensure_proc_group()
    if problem:
        problems.append(problem)
        print(f"  NOT applied: hidepid on /proc ({problem})", file=sys.stderr)
    elif Path("/proc").is_mount():
        rc, out = _run(["mount", "-o", f"remount,hidepid=2,gid={gid}", "/proc"])
        if rc == 0:
            print(f"  Applied hide other users' processes on /proc (group {PROC_GROUP} sees all)")
        else:
            problems.append(f"/proc: {out}")
            print(f"  Note (/proc): {out}", file=sys.stderr)

    remounts = [
        # (path, options, description)
        ("/tmp",     "remount,noexec,nosuid,nodev",       "no-exec /tmp"),
        ("/dev/shm", "remount,noexec,nosuid,nodev",       "no-exec /dev/shm"),
    ]

    for path, opts, desc in remounts:
        if not Path(path).is_mount():
            print(f"  skip {path}: not a mountpoint")
            continue
        r = subprocess.run(
            ["mount", "-o", opts, path],
            capture_output=True, text=True
        )
        if r.returncode == 0:
            print(f"  Applied {desc} on {path}")
        else:
            print(f"  Note ({path}): {r.stderr.strip()}", file=sys.stderr)

    # Persistent fstab entries
    fstab_path = FSTAB
    try:
        fstab = fstab_path.read_text()
    except Exception:
        fstab = ""

    additions = []
    if "tmpfs /tmp " not in fstab and "tmpfs\t/tmp\t" not in fstab:
        additions.append(
            "tmpfs\t/tmp\t\ttmpfs\tdefaults,noexec,nosuid,nodev,size=512M\t0 0"
        )
    if "tmpfs /dev/shm" not in fstab and "tmpfs\t/dev/shm" not in fstab:
        additions.append(
            "tmpfs\t/dev/shm\ttmpfs\tdefaults,noexec,nosuid,nodev\t0 0"
        )

    if additions:
        with fstab_path.open("a") as f:
            f.write("\n# Shadow OS hardened mounts — written by shadow-harden\n")
            for line in additions:
                f.write(line + "\n")
        print(f"  Added {len(additions)} persistent fstab entry/entries.")
    else:
        print("  fstab entries already present.")

    # /proc hidepid at every boot: a unit (fstab cannot remount /proc with a
    # gid reliably). Rewritten when it differs, so that units written by older
    # versions (hidepid=2 without gid=, which broke pkexec) are replaced.
    if gid is not None and not problem:
        text = render_hidepid_unit(gid)
        try:
            current = HIDEPID_UNIT.read_text()
        except OSError:
            current = None
        if current != text:
            HIDEPID_UNIT.write_text(text)
            for argv in (["systemctl", "daemon-reload"], ["systemctl", "enable", HIDEPID_UNIT.name]):
                rc, out = _run(argv)
                if rc != 0:
                    problems.append(f"{' '.join(argv)}: {out}")
            print(f"  Installed {HIDEPID_UNIT.name} (hidepid=2, gid={gid}) for every boot.")

    s = load_state()
    s["filesystems_hardened"] = not problems
    save_state(s)
    if problems:
        print("Filesystem hardening incomplete:", file=sys.stderr)
        for message in problems:
            print(f"  - {message}", file=sys.stderr)
        sys.exit(1)
    print("Filesystem hardening applied.")


def cmd_migrate_hidepid() -> None:
    """Package upgrade: bring a proc-shadow-hidepid.service of an older version
    up to date (the /proc part of fs-harden only; /tmp, /dev/shm and fstab are
    left alone). The shadow-harden of Shadow OS 0.2.0 (not yet in the package)
    wrote it with hidepid=2, no gid= and no escape hatch: polkitd could not see
    the processes asking it for an authorisation, so pkexec failed at every
    start. --offline (postinst in a chroot): only the files; nothing is
    remounted, no service is restarted."""
    live = "--offline" not in sys.argv[2:]
    try:
        current = HIDEPID_UNIT.read_text()
    except FileNotFoundError:
        print(f"No {HIDEPID_UNIT.name}: fs-harden was never used; nothing to do.")
        return
    except OSError as exc:
        print(f"Cannot read {HIDEPID_UNIT}: {exc.strerror}", file=sys.stderr)
        sys.exit(1)

    gid, problem = ensure_proc_group(live=live)
    if problem is None and current == render_hidepid_unit(gid):
        print(f"{HIDEPID_UNIT.name} is up to date.")
        return

    if problem is not None:
        # Hiding processes from polkitd breaks pkexec: rather nothing hidden.
        _run(["systemctl", "disable", HIDEPID_UNIT.name])
        try:
            HIDEPID_UNIT.unlink()
        except FileNotFoundError:
            pass
        if live:
            if hidepid_status()["hidepid"] not in ("off", "unknown"):
                rc, out = _run(["mount", "-o", "remount,hidepid=0", "/proc"])
                if rc != 0:
                    print(f"  Note (/proc): {out}", file=sys.stderr)
            _run(["systemctl", "daemon-reload"])
        print(f"WARNING: {problem}. {HIDEPID_UNIT.name} was removed so that pkexec keeps working: "
              "other users' processes are visible again. Run 'sudo shadow-harden fs-harden' once "
              "the problem is solved.", file=sys.stderr)
        sys.exit(1)

    # The unit keeps its enabled or disabled state; only its text changes.
    HIDEPID_UNIT.write_text(render_hidepid_unit(gid))
    print(f"Rewrote {HIDEPID_UNIT.name}: hidepid=2, gid={gid} ({PROC_GROUP}), skipped with {HIDEPID_ESCAPE}.")
    if not live:
        return
    problems = []
    rc, out = _run(["systemctl", "daemon-reload"])
    if rc != 0:
        problems.append(f"systemctl daemon-reload: {out}")
    state = hidepid_status()
    if state["hidepid"] not in ("off", "unknown") and state["gid"] is None:
        # /proc is mounted the old way right now: pkexec works again at once.
        rc, out = _run(["mount", "-o", f"remount,hidepid=2,gid={gid}", "/proc"])
        if rc == 0:
            print(f"  /proc remounted with gid={gid}: polkit sees every process again.")
        else:
            problems.append(f"/proc: {out}")
    if problems:
        for message in problems:
            print(f"  - {message}", file=sys.stderr)
        sys.exit(1)


def current_level() -> str:
    """The level named in the marker file, else the default."""
    try:
        name = LEVEL_MARKER.read_text().strip()
        if name in LEVELS:
            return name
    except Exception:
        pass
    return DEFAULT_LEVEL


def cmd_level() -> None:
    """Show, or with an argument set, the hardening level."""
    target = sys.argv[2] if len(sys.argv) > 2 else None

    if target is None:
        now = current_level()
        print(f"Current hardening level: {now}\n")
        for name in LEVEL_ORDER:
            mark = "*" if name == now else " "
            print(f" {mark} {name:9s} {LEVEL_NOTES[name]}")
        print("\nChange it with:  shadow-harden level <name>")
        return

    if target not in LEVELS:
        print(f"Unknown level: {target}", file=sys.stderr)
        print(f"Available: {', '.join(LEVEL_ORDER)}", file=sys.stderr)
        sys.exit(1)

    settings = LEVELS[target]
    LEVEL_FILE.write_text(
        "# Shadow OS hardening level — written by `shadow-harden level`.\n"
        "# Do not edit by hand; it is overwritten. Change the level with the\n"
        "# command above or the Control Center.\n"
        f"# level = {target}\n\n"
        + "".join(f"{key} = {value}\n" for key, value in settings.items())
    )
    # Apply now (best-effort: a key may be absent on some kernels).
    for key, value in settings.items():
        subprocess.run(["sysctl", "-qw", f"{key}={value}"], check=False)

    LEVEL_MARKER.parent.mkdir(parents=True, exist_ok=True)
    LEVEL_MARKER.write_text(target + "\n")

    s = load_state()
    s["hardening_level"] = target
    save_state(s)

    print(f"Hardening level set to {target}.")
    print(LEVEL_NOTES[target])
    if target == "paranoid":
        print("\nWARNING: web-browser and Flatpak sandboxes will not start at this "
              "level. Switch back with:  shadow-harden level hardened")


# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

COMMANDS = {
    "status":           cmd_status,
    "aide-init":        cmd_aide_init,
    "aide-check":       cmd_aide_check,
    "enforce-apparmor": cmd_enforce_apparmor,
    "boot-harden":      cmd_boot_harden,
    "fs-harden":        cmd_fs_harden,
    "migrate-hidepid":  cmd_migrate_hidepid,
    "level":            cmd_level,
}


def main() -> None:
    if os.geteuid() != 0:
        print("shadow-harden must run as root (use pkexec).", file=sys.stderr)
        sys.exit(1)

    if len(sys.argv) < 2:
        cmd_status()
        return

    command = sys.argv[1]
    if command not in COMMANDS:
        print(f"Unknown command: {command}", file=sys.stderr)
        print(f"Available: {', '.join(COMMANDS)}", file=sys.stderr)
        sys.exit(1)

    COMMANDS[command]()


if __name__ == "__main__":
    main()
