#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Set up an offline model for the Shadow Assistant, so it answers without
# sending anything to the cloud. It installs ollama (a local OpenAI-compatible
# model server) and downloads one model, then turns on the assistant's local
# mode.
#
#   shadow-assistant-local setup [MODEL]   install ollama, pull MODEL
#                                          (default: llama3.1:8b), enable local mode
#   shadow-assistant-local status          show whether the local server and
#                                          model are ready
#   shadow-assistant-local off             switch the assistant back to the cloud
#
# A capable GPU makes this usable; on CPU only it works but is slow. The model
# download is several gigabytes. Run as your normal user.
set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/shadow/assistant.conf"
ENDPOINT="http://127.0.0.1:11434"
DEFAULT_MODEL="llama3.1:8b"

log()  { printf '\033[1;36m[assistant-local]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[assistant-local]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[assistant-local] ERROR:\033[0m %s\n' "$*" >&2; exit 1; }

ini_set() {  # section key value  — minimal INI writer for assistant.conf
    local section="$1" key="$2" value="$3"
    mkdir -p "$(dirname "$CONF")"
    touch "$CONF"
    python3 - "$CONF" "$section" "$key" "$value" <<'PY'
import configparser, sys
path, section, key, value = sys.argv[1:5]
c = configparser.ConfigParser()
c.read(path)
if not c.has_section(section):
    c.add_section(section)
c.set(section, key, value)
with open(path, "w") as f:
    c.write(f)
PY
}

cmd_setup() {
    [ "$(id -u)" -ne 0 ] || die "run as your normal user, not root."
    local model="${1:-$DEFAULT_MODEL}"
    if ! command -v ollama >/dev/null; then
        log "installing ollama (the local model server)…"
        if command -v apt-get >/dev/null && apt-get install -y ollama >/dev/null 2>&1; then
            :
        else
            warn "ollama is not in the repositories; using the official installer."
            curl -fsSL https://ollama.com/install.sh | sh || die "ollama install failed."
        fi
    fi
    log "starting the ollama service…"
    systemctl --user start ollama 2>/dev/null || sudo systemctl start ollama 2>/dev/null || (ollama serve >/dev/null 2>&1 &)
    sleep 2
    log "downloading the model '$model' (several GB; one time)…"
    ollama pull "$model" || die "could not download the model."
    log "enabling the assistant's local mode…"
    ini_set api local true
    ini_set api local_base_url "$ENDPOINT/v1"
    ini_set models local "$model"
    log "done. The Shadow Assistant now runs offline with '$model'."
    log "Turn it off again with:  shadow-assistant-local off"
}

cmd_status() {
    command -v ollama >/dev/null && echo "ollama     : installed" || { echo "ollama     : not installed"; return; }
    if curl -fsS --max-time 4 "$ENDPOINT/api/tags" >/dev/null 2>&1; then
        echo "server     : running at $ENDPOINT"
        echo "models     :"
        ollama list 2>/dev/null | sed '1d;s/^/  /' || true
    else
        echo "server     : not running (start it with: ollama serve)"
    fi
    if command -v python3 >/dev/null && [ -f "$CONF" ]; then
        local on
        on=$(python3 -c "import configparser,sys;c=configparser.ConfigParser();c.read('$CONF');print(c.get('api','local',fallback='false'))" 2>/dev/null || echo false)
        echo "assistant  : local mode ${on}"
    fi
}

cmd_off() {
    ini_set api local false
    log "the assistant will use the cloud again."
}

case "${1:-}" in
    setup)  shift; cmd_setup "${1:-}" ;;
    status) cmd_status ;;
    off)    cmd_off ;;
    -h|--help|"") sed -n '3,19p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$1' (setup | status | off)" ;;
esac
