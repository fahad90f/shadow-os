#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Set up an offline model for the Shadow Assistant, so it answers without
# sending anything to the cloud. It installs ollama (a local OpenAI-compatible
# model server) and downloads one model, then turns on the assistant's local
# mode.
#
#   shadow-assistant-local setup [MODEL]   install ollama, pull MODEL
#                                          (default: llama3.1:8b), enable local mode
#   shadow-assistant-local status          show whether the local server and
#                                          model are ready
#   shadow-assistant-local off             switch the assistant back to the cloud
#
# A capable GPU makes this usable; on CPU only it works but is slow. The model
# download is several gigabytes. Run as your normal user.
#
# ollama is not packaged for Debian. When it is missing, setup offers to run
# ollama's own installer, pinned: the installer script of release v0.40.14 is
# downloaded to a file, checked against its sha256 and run only after you
# agree (it uses sudo, installs /usr/local/bin/ollama and a system service);
# it installs exactly that ollama version (the release archive it downloads
# over HTTPS is pinned by version, not by a checksum). Or install ollama
# yourself and run setup again.
#
# ~/.config/shadow/assistant.conf holds your API key: it is created private
# (mode 600) and edited line by line. Every other line (comments, your key)
# is kept as it is; the file is replaced atomically, so a full disk never
# leaves it empty.
set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/shadow/assistant.conf"
ENDPOINT="http://127.0.0.1:11434"
DEFAULT_MODEL="llama3.1:8b"
OLLAMA_VERSION=0.40.14
OLLAMA_INSTALLER_URL="https://raw.githubusercontent.com/ollama/ollama/v$OLLAMA_VERSION/scripts/install.sh"
OLLAMA_INSTALLER_SHA256=25f64b810b947145095956533e1bdf56eacea2673c55a7e586be4515fc882c9f

log()  { printf '\033[1;36m[assistant-local]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[assistant-local]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[assistant-local] ERROR:\033[0m %s\n' "$*" >&2; exit 1; }

# Line-based editor of assistant.conf (Qt INI). "set SECTION KEY VALUE" changes or
# adds one line; "get SECTION KEY" prints a value (never the API key). The file and
# the values are passed as arguments, never pasted into the program.
CONF_PY=$(cat <<'PY'
import os, re, sys, tempfile

INLINE = re.compile(r'(?:^|\s)[#;].*$', re.S)          # the assistant's own comment rule
SECRET = re.compile(r'(key|token|secret|passw(or)?d)', re.I)


def read(path):
    try:
        with open(path, 'rb') as f:
            return f.read().decode('utf-8', 'surrogateescape')
    except FileNotFoundError:
        return ''


def write(path, text):
    path = os.path.realpath(path)               # a symlinked file: replace its target
    d = os.path.dirname(path)
    os.makedirs(d, mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix='.assistant.conf.', dir=d)   # created 0600
    try:
        with os.fdopen(fd, 'wb') as f:
            f.write(text.encode('utf-8', 'surrogateescape'))
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def cmd_set(path, section, key, value):
    if SECRET.search(key):
        sys.exit('refusing to write a secret')
    lines = read(path).splitlines(keepends=True)
    nl = '\r\n' if lines and lines[0].endswith('\r\n') else '\n'
    if lines and not lines[-1].endswith('\n'):
        lines[-1] += nl
    cur, start, end, done = None, None, None, False
    for i, line in enumerate(lines):
        s = line.strip()
        if s.startswith('[') and s.endswith(']'):
            if cur == section and end is None:
                end = i
            cur = s[1:-1].strip()
            if cur == section and start is None:
                start = i
            continue
        if cur == section and s and s[0] not in '#;' and '=' in s and s.split('=', 1)[0].strip() == key:
            lines[i] = key + '=' + value + nl
            done = True
    if not done:
        if start is None:
            if lines and lines[-1].strip():
                lines.append(nl)
            lines += ['[' + section + ']' + nl, key + '=' + value + nl]
        else:
            j = end if end is not None else len(lines)
            while j > start + 1 and not lines[j - 1].strip():
                j -= 1
            lines.insert(j, key + '=' + value + nl)
    write(path, ''.join(lines))


def cmd_get(path, section, key, default=''):
    if SECRET.search(key):
        sys.exit('refusing to read a secret')
    cur, val = '', default
    for line in read(path).splitlines():
        s = line.strip()
        if not s or s[0] in '#;':
            continue
        if s.startswith('[') and s.endswith(']'):
            cur = s[1:-1].strip()
        elif cur == section and '=' in s and s.split('=', 1)[0].strip() == key:
            val = INLINE.sub('', s.split('=', 1)[1]).strip()
    print(val)


{'set': cmd_set, 'get': cmd_get}[sys.argv[1]](*sys.argv[2:])
PY
)
ini_set() { python3 -I -c "$CONF_PY" set "$CONF" "$1" "$2" "$3"; }   # section key value
ini_get() { python3 -I -c "$CONF_PY" get "$CONF" "$1" "$2" "${3:-}"; }

install_ollama() {
    command -v curl >/dev/null || die "curl is needed to download ollama's installer: sudo apt install curl"
    INSTALLER_TMP=$(mktemp -d)
    trap 'rm -rf -- "$INSTALLER_TMP"' EXIT
    local tmp=$INSTALLER_TMP
    log "downloading ollama's installer (release v$OLLAMA_VERSION)…"
    curl -fsSL --proto '=https' -o "$tmp/install.sh" "$OLLAMA_INSTALLER_URL" \
        || die "could not download $OLLAMA_INSTALLER_URL"
    local got
    got=$(sha256sum "$tmp/install.sh" | cut -d' ' -f1)
    [ "$got" = "$OLLAMA_INSTALLER_SHA256" ] \
        || die "the installer's sha256 is $got, not the pinned $OLLAMA_INSTALLER_SHA256: not running it"
    log "verified (sha256 $OLLAMA_INSTALLER_SHA256)."
    log "It will use sudo to install ollama $OLLAMA_VERSION into /usr/local and add an 'ollama' system"
    log "service (and, with an NVIDIA or AMD GPU, may add the vendor's driver repository)."
    local a=""
    if [ -t 0 ]; then
        printf '[assistant-local] Run it now? [y/N] '
        read -r a || a=""
    fi
    case "$a" in
        [Yy]*) ;;
        *) die "not installed. Install ollama yourself (https://ollama.com/download/linux), then run: shadow-assistant-local setup" ;;
    esac
    OLLAMA_VERSION=$OLLAMA_VERSION sh "$tmp/install.sh" || die "the ollama installer failed."
}

cmd_setup() {
    [ "$(id -u)" -ne 0 ] || die "run as your normal user, not root."
    local model="${1:-$DEFAULT_MODEL}"
    if ! command -v ollama >/dev/null; then
        warn "ollama (the local model server) is not installed; it is not packaged for Debian."
        install_ollama
    fi
    log "starting the ollama service…"
    systemctl --user start ollama 2>/dev/null || sudo systemctl start ollama 2>/dev/null || (ollama serve >/dev/null 2>&1 &)
    sleep 2
    log "downloading the model '$model' (several GB; one time)…"
    ollama pull "$model" || die "could not download the model."
    log "enabling the assistant's local mode…"
    ini_set api local true
    ini_set api local_base_url "$ENDPOINT/v1"
    ini_set models local "$model"
    log "done. The Shadow Assistant now runs offline with '$model'."
    log "Turn it off again with:  shadow-assistant-local off"
}

cmd_status() {
    if ! command -v ollama >/dev/null; then echo "ollama     : not installed"; return; fi
    echo "ollama     : installed"
    if curl -fsS --max-time 4 "$ENDPOINT/api/tags" >/dev/null 2>&1; then
        echo "server     : running at $ENDPOINT"
        echo "models     :"
        ollama list 2>/dev/null | sed '1d;s/^/  /' || true
    else
        echo "server     : not running (start it with: ollama serve)"
    fi
    if command -v python3 >/dev/null && [ -f "$CONF" ]; then
        echo "assistant  : local mode $(ini_get api local false)"
    fi
}

cmd_off() {
    ini_set api local false
    log "the assistant will use the cloud again."
}

case "${1:-}" in
    setup)  shift; cmd_setup "${1:-}" ;;
    status) cmd_status ;;
    off)    cmd_off ;;
    -h|--help|"") sed -n '3,27p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$1' (setup | status | off)" ;;
esac
