# SPDX-License-Identifier: GPL-3.0-or-later
# Shadow OS — comprehensive auditd rules.
# Installed as /etc/audit/rules.d/90-shadow-audit.rules.
# Loaded by auditd at service start; apply immediately with:
#   augenrules --load

# ---------------------------------------------------------------------------
# Initialisation
# ---------------------------------------------------------------------------

# Delete all existing rules (clean slate).
-D

# Increase kernel audit buffer to handle burst logging.
-b 8192

# Failure mode: 1 = log to syslog on overflow (not panic).
-f 1

# ---------------------------------------------------------------------------
# Identity and authentication files
# ---------------------------------------------------------------------------
# Alert whenever these files are written — indicates possible account
# manipulation, privilege escalation, or compromise.

-w /etc/passwd         -p wa -k identity
-w /etc/shadow         -p wa -k identity
-w /etc/group          -p wa -k identity
-w /etc/gshadow        -p wa -k identity
-w /etc/sudoers        -p wa -k identity
-w /etc/sudoers.d/     -p wa -k identity
-w /etc/pam.d/         -p wa -k identity
-w /etc/security/      -p wa -k identity

# ---------------------------------------------------------------------------
# SSH configuration
# ---------------------------------------------------------------------------

-w /etc/ssh/           -p wa -k sshd_config
-w /root/.ssh/         -p wa -k sshd_config

# ---------------------------------------------------------------------------
# Kernel module loading
# ---------------------------------------------------------------------------
# Log any kernel module insertion or removal — a common persistence technique.

-a always,exit -F arch=b64 -S init_module   -k modules
-a always,exit -F arch=b32 -S init_module   -k modules
-a always,exit -F arch=b64 -S finit_module  -k modules
-a always,exit -F arch=b32 -S finit_module  -k modules
-a always,exit -F arch=b64 -S delete_module -k modules
-a always,exit -F arch=b32 -S delete_module -k modules

-w /sbin/insmod  -p x -k modules
-w /sbin/rmmod   -p x -k modules
-w /sbin/modprobe -p x -k modules

# ---------------------------------------------------------------------------
# Setuid / privilege escalation
# ---------------------------------------------------------------------------
# Log execve calls where the effective UID is root but the audit UID is a
# normal user — catches sudo, su, setuid helpers, and suid exploits.

-a always,exit -F arch=b64 -S execve -F euid=0 -F auid>=1000 -F auid!=-1 -k setuid_exec
-a always,exit -F arch=b32 -S execve -F euid=0 -F auid>=1000 -F auid!=-1 -k setuid_exec

-w /usr/bin/sudo  -p x -k priv_escalation
-w /usr/bin/su    -p x -k priv_escalation
-w /bin/sudo      -p x -k priv_escalation
-w /bin/su        -p x -k priv_escalation

# ---------------------------------------------------------------------------
# ptrace — anti-debug / process injection
# ---------------------------------------------------------------------------
# ptrace is used by debuggers and also by exploits to inject code into
# running processes.

-a always,exit -F arch=b64 -S ptrace -k ptrace
-a always,exit -F arch=b32 -S ptrace -k ptrace

# ---------------------------------------------------------------------------
# Firewall / network filter modifications
# ---------------------------------------------------------------------------

-w /etc/iptables/        -p wa -k network_filter
-w /etc/nftables.conf    -p wa -k network_filter
-w /etc/nftables.d/      -p wa -k network_filter

# ---------------------------------------------------------------------------
# Boot directory
# ---------------------------------------------------------------------------
# Writes to /boot could indicate bootkit/rootkit installation.

-w /boot/ -p wa -k boot_tamper

# ---------------------------------------------------------------------------
# Time modification
# ---------------------------------------------------------------------------
# Log attempts to manipulate the system clock (used to defeat log correlation).

-a always,exit -F arch=b64 -S adjtimex -S settimeofday -S clock_settime -k time_change
-a always,exit -F arch=b32 -S adjtimex -S settimeofday -S clock_settime -k time_change
-w /etc/localtime -p wa -k time_change

# ---------------------------------------------------------------------------
# User/session events
# ---------------------------------------------------------------------------

-w /var/log/lastlog       -p wa -k session
-w /var/run/faillock/     -p wa -k session
-w /var/run/utmp          -p wa -k session
-w /var/log/wtmp          -p wa -k session
-w /var/log/btmp          -p wa -k session

# ---------------------------------------------------------------------------
# Cron jobs
# ---------------------------------------------------------------------------

-w /etc/cron.allow   -p wa -k cron
-w /etc/cron.deny    -p wa -k cron
-w /etc/cron.d/      -p wa -k cron
-w /etc/cron.daily/  -p wa -k cron
-w /etc/cron.hourly/ -p wa -k cron
-w /etc/cron.monthly/ -p wa -k cron
-w /etc/cron.weekly/ -p wa -k cron
-w /etc/crontab      -p wa -k cron
-w /var/spool/cron/  -p wa -k cron

# ---------------------------------------------------------------------------
# Shared library / dynamic linker tampering
# ---------------------------------------------------------------------------

-w /etc/ld.so.conf    -p wa -k libraries
-w /etc/ld.so.conf.d/ -p wa -k libraries
-w /etc/ld.so.preload -p wa -k libraries

# ---------------------------------------------------------------------------
# Lock audit rules (immutable until reboot)
# ---------------------------------------------------------------------------
# -e 2 makes the audit configuration immutable so a compromised process
# cannot disable auditing without rebooting.

-e 2
