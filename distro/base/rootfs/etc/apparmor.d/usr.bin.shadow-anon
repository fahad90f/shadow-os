# SPDX-License-Identifier: GPL-3.0-or-later
# AppArmor profile for /usr/bin/shadow-anon
# Shadow OS identity and anonymity engine (the Hide Me panel runs it as root
# through pkexec).
#
# This profile confines the Python program itself to the files it manages.
# The system tools it drives (NetworkManager's nmcli, systemctl, iptables/nft,
# ip, hostnamectl, …) reconfigure the whole machine by design; they run under
# their own profile when one exists and unconfined otherwise (PUx), exactly
# as when an administrator types them. Confining them inside this profile
# broke every feature: on Debian /bin is a link to /usr/bin, /bin/sh is dash,
# iptables is /usr/sbin/xtables-nft-multi and modprobe is /usr/bin/kmod, and
# AppArmor only matches those resolved paths.

#include <tunables/global>

/usr/bin/shadow-anon {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/python>
  #include <abstractions/openssl>
  #include <abstractions/ssl_certs>

  # ---- Capabilities -------------------------------------------------------
  capability net_admin,
  capability net_raw,
  capability sys_admin,
  capability sys_module,
  capability dac_override,
  capability dac_read_search,
  capability chown,
  capability fowner,
  capability fsetid,
  capability kill,
  capability setuid,
  capability setgid,
  capability linux_immutable,

  # The leak test talks to the network (curl, torsocks); iptables and ip use
  # netlink.
  network inet,
  network inet6,
  network netlink raw,
  network unix,

  # Child processes are signalled (timeouts) and report back.
  signal,
  unix,

  # ---- Own program and the Python runtime --------------------------------
  /usr/bin/shadow-anon              r,
  /usr/bin/python3*                 ix,
  /usr/lib/python3*/                r,
  /usr/lib/python3*/**              mr,
  /usr/lib/python3/dist-packages/** mr,
  /usr/local/lib/python3*/**        r,
  /etc/python3*/**                  r,

  # ---- Proc and sys --------------------------------------------------------
  @{PROC}/                          r,
  @{PROC}/**                        r,
  @{PROC}/sys/net/**                rw,
  @{PROC}/sys/kernel/**             rw,
  @{PROC}/sys/vm/**                 rw,
  /sys/                             r,
  /sys/**                           r,

  /dev/null                         rw,
  /dev/tty                          rw,
  /dev/pts/*                        rw,
  /usr/share/terminfo/**            r,
  /etc/terminfo/**                  r,

  # ---- State ------------------------------------------------------------------
  /run/shadow-anon-state.json       rw,

  # ---- Tor ----------------------------------------------------------------------
  /etc/tor/                         rw,
  /etc/tor/**                       rw,
  /var/lib/tor/                     r,
  /var/lib/tor/**                   r,
  /run/tor/                         r,
  /run/tor/**                       r,
  /usr/lib/@{multiarch}/torsocks/** mr,
  /usr/lib/torsocks/**              mr,

  # ---- Files it writes --------------------------------------------------------
  /etc/NetworkManager/conf.d/       rw,
  /etc/NetworkManager/conf.d/**     rw,
  /etc/sysctl.d/                    rw,
  /etc/sysctl.d/**                  rw,
  /etc/udev/rules.d/                rw,
  /etc/udev/rules.d/**              rw,
  /etc/systemd/system/              r,
  /etc/systemd/system/shadow-anon-rotate.timer.d/   rw,
  /etc/systemd/system/shadow-anon-rotate.timer.d/** rw,

  # DNS: /etc/resolv.conf may be a link into /run.
  /etc/resolv.conf                  rw,
  /etc/resolv.conf.shadow-backup    rw,
  /run/NetworkManager/resolv.conf   rw,
  /run/NetworkManager/no-stub-resolv.conf rw,
  /run/systemd/resolve/*.conf       rw,

  # ---- Log wipe ----------------------------------------------------------------
  /var/log/                         r,
  /var/log/**                       rw,
  /home/                            r,
  /home/*/                          r,
  /home/*/.bash_history             rw,
  /home/*/.zsh_history              rw,
  /home/*/.fish_history             rw,
  /home/*/.cache/                   r,
  /home/*/.cache/thumbnails/        rw,
  /home/*/.cache/thumbnails/**      rw,
  /root/                            r,
  /root/.bash_history               rw,
  /root/.zsh_history                rw,
  /root/.fish_history               rw,
  /tmp/                             r,
  /tmp/**                           rw,

  # ---- Helpers that run inside this profile -----------------------------------
  /usr/bin/dash                     ix,
  /usr/bin/bash                     ix,
  /usr/bin/clear                    ix,
  /usr/bin/find                     ix,
  /usr/bin/curl                     ix,
  /usr/bin/torsocks                 ix,
  /usr/bin/env                      ix,
  /usr/bin/getopt                   ix,
  /usr/bin/basename                 ix,
  /usr/bin/dirname                  ix,
  /usr/bin/readlink                 ix,
  /usr/bin/cat                      ix,
  /usr/bin/sed                      ix,
  /usr/bin/grep                     ix,
  /usr/bin/id                       ix,
  /usr/bin/uname                    ix,
  /usr/bin/which                    ix,

  # ---- System tools: their own profile, or unconfined ------------------------
  /usr/bin/nmcli                    PUx,
  /usr/bin/systemctl                PUx,
  /usr/bin/hostnamectl              PUx,
  /usr/bin/timedatectl              PUx,
  /usr/bin/journalctl               PUx,
  /usr/bin/udevadm                  PUx,
  /usr/bin/kmod                     PUx,
  /usr/bin/ip                       PUx,
  /usr/bin/hostname                 PUx,
  /usr/bin/chattr                   PUx,
  /usr/bin/macchanger               PUx,
  /usr/sbin/xtables-nft-multi       PUx,
  /usr/sbin/xtables-legacy-multi    PUx,
  /usr/sbin/iptables*               PUx,
  /usr/sbin/ip6tables*              PUx,
  /usr/sbin/nft                     PUx,
  /usr/sbin/sysctl                  PUx,
  /usr/sbin/rfkill                  PUx,
  /usr/sbin/macchanger              PUx,
  /usr/sbin/modprobe                PUx,

  # Site-specific additions.
  include if exists <local/usr.bin.shadow-anon>
}
