[Desktop Entry]
Type=Application
Name=Control Center
GenericName=System Settings
Comment=Configure displays, network, sound, power, users, security and appearance
Exec=shadow-control-center %u
Icon=org.shadow.controlcenter
Terminal=false
Categories=Settings;System;
Keywords=settings;preferences;configuration;display;network;wifi;bluetooth;sound;power;users;privacy;firewall;appearance;theme;
StartupNotify=true
StartupWMClass=org.shadow.controlcenter
X-SHADOW-Component=control-center
