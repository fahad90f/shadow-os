<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<policyconfig>
  <vendor>Shadow OS</vendor>
  <vendor_url>https://github.com/fahad90f/shadow-os</vendor_url>

  <action id="org.shadow.controlcenter.wifiaudit.run">
    <description>Run a Wi-Fi security audit</description>
    <message>Authentication is required to test a Wi-Fi network's password strength.
Only run this against networks you own or have written permission to test.</message>
    <icon_name>org.shadow.controlcenter</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/shadow/wifi-audit-helper</annotate>
  </action>
</policyconfig>
