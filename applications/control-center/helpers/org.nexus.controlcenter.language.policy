<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<policyconfig>
  <vendor>NEXUS OS</vendor>
  <vendor_url>https://github.com/fahad90fa/Custom-OS</vendor_url>

  <action id="org.nexus.controlcenter.language.generate">
    <description>Install a language or region format</description>
    <message>Authentication is required to make a new language or region format available on this computer</message>
    <icon_name>org.nexus.controlcenter</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nexus/language-helper</annotate>
  </action>
</policyconfig>
