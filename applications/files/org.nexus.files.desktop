[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse and manage files, drives and network locations
Exec=nexus-files %U
Icon=org.nexus.files
Terminal=false
Categories=System;FileTools;FileManager;Utility;Core;
Keywords=folder;manager;explore;disk;filesystem;network;archive;trash;
MimeType=inode/directory;
StartupNotify=true
StartupWMClass=org.nexus.files
X-NEXUS-Component=files
