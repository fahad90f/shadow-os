[Desktop Entry]
Type=Application
Name=System Information
GenericName=Hardware and Software Summary
Comment=View details about this computer and the installed system
Exec=nexus-sysinfo
Icon=org.nexus.sysinfo
Terminal=false
Categories=System;Settings;HardwareSettings;
Keywords=about;hardware;version;kernel;cpu;memory;firmware;
StartupNotify=true
StartupWMClass=org.nexus.sysinfo
X-NEXUS-Component=sysinfo
