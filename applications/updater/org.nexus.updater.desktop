[Desktop Entry]
Type=Application
Name=NEXUS Updater
GenericName=Software Updates
Comment=Install system updates, review update history and repair the package system
Exec=nexus-updater
Icon=org.nexus.updater
Terminal=false
Categories=System;Settings;PackageManager;
Keywords=update;upgrade;security;patch;packages;apt;restart;history;repair;
StartupNotify=true
StartupWMClass=org.nexus.updater
X-NEXUS-Component=updater
