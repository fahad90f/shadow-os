# Installs the updates prepared by "shadow-offline-update prepare" while the
# system boots into system-update.target (systemd.offline-updates(7)), then
# restarts into the updated system.
[Unit]
Description=Install prepared Shadow OS updates
Documentation=man:systemd.offline-updates(7)
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target system-update-pre.target systemd-journald.socket
Before=shutdown.target system-update.target
ConditionPathIsSymbolicLink=/system-update

[Service]
Type=oneshot
ExecStart=/usr/sbin/shadow-offline-update apply
StandardOutput=journal+console
# Never leave the machine in the update boot.
FailureAction=reboot
