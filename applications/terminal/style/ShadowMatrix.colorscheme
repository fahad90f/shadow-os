# SHADOW Terminal colour scheme — "SHADOW Matrix".
# Original work for Shadow OS. SPDX-License-Identifier: GPL-3.0-or-later
#
# Green phosphor on black: the whole palette leans into a CRT-green cast, yet
# every ANSI slot stays distinguishable — red is kept warm for errors so
# tooling that colours by status still reads correctly.

[Background]
Color=#010603

[BackgroundIntense]
Color=#06140B

[BackgroundFaint]
Color=#010603

[Foreground]
Color=#3BE873

[ForegroundIntense]
Color=#7CFFA6

[ForegroundFaint]
Color=#1E8F49

[Color0]
Color=#0A1C10

[Color0Intense]
Color=#2F6B45

[Color0Faint]
Color=#061109

[Color1]
Color=#FF5A5F

[Color1Intense]
Color=#FF8C8F

[Color1Faint]
Color=#803034

[Color2]
Color=#2DE86A

[Color2Intense]
Color=#74FFA0

[Color2Faint]
Color=#167A3A

[Color3]
Color=#B6F24A

[Color3Intense]
Color=#D8FF86

[Color3Faint]
Color=#5E7F26

[Color4]
Color=#30C27A

[Color4Intense]
Color=#5CF0A6

[Color4Faint]
Color=#19663F

[Color5]
Color=#5FE0B0

[Color5Intense]
Color=#92FFD6

[Color5Faint]
Color=#2E7760

[Color6]
Color=#45E8C0

[Color6Intense]
Color=#86FFE0

[Color6Faint]
Color=#227B66

[Color7]
Color=#9DE8B4

[Color7Intense]
Color=#D6FFE2

[Color7Faint]
Color=#4A7D5C

[General]
Description=SHADOW Matrix
Opacity=1
