# SHADOW Terminal colour scheme — "SHADOW Mono Ghost".
# Original work for Shadow OS. SPDX-License-Identifier: GPL-3.0-or-later
#
# A restrained, nearly monochrome scheme: cool slate greys with a faint cyan
# cast. ANSI colours are desaturated into ghostly tints that stay apart from
# one another (so ls/grep still read) without ever shouting. For long,
# distraction-free sessions.

[Background]
Color=#07090E

[BackgroundIntense]
Color=#111620

[BackgroundFaint]
Color=#07090E

[Foreground]
Color=#C4CDDC

[ForegroundIntense]
Color=#E8EDF6

[ForegroundFaint]
Color=#798398

[Color0]
Color=#151B26

[Color0Intense]
Color=#424E63

[Color0Faint]
Color=#0D121B

