# SHADOW Terminal colour scheme — "SHADOW Cyberpit".
# Original work for Shadow OS. SPDX-License-Identifier: GPL-3.0-or-later
#
# A synthwave "cyber pit": a deep indigo-violet ground with hot magenta, pink
# and electric-cyan accents. Warmer and moodier than Obsidian, still tuned so
# normal foreground text clears AA contrast on the background.

[Background]
Color=#120A1E

[BackgroundIntense]
Color=#1E1230

[BackgroundFaint]
Color=#120A1E

[Foreground]
Color=#EFE2FF

[ForegroundIntense]
Color=#FDF7FF

[ForegroundFaint]
Color=#A78FC4

[Color0]
Color=#2A1B3E

[Color0Intense]
Color=#5E4780

[Color0Faint]
Color=#1A1029

[Color1]
Color=#FF4D8D

[Color1Intense]
Color=#FF84B2

[Color1Faint]
Color=#80274A

[Color2]
Color=#4DF0C0

[Color2Intense]
Color=#8CFFDC

[Color2Faint]
Color=#1F7861

[Color3]
Color=#FFC94D

[Color3Intense]
Color=#FFDE8A

[Color3Faint]
Color=#806226

[Color4]
Color=#5B9BFF

[Color4Intense]
Color=#95C2FF

[Color4Faint]
Color=#2D4E80

[Color5]
Color=#FF6EE7

[Color5Intense]
Color=#FFA6F0

[Color5Faint]
Color=#803773

[Color6]
Color=#45E0F2

[Color6Intense]
Color=#8CF0FA

[Color6Faint]
Color=#227079

[Color7]
Color=#DAC7F2

[Color7Intense]
