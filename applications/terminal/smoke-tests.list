# <binary> [arguments...] — each line is launched by tests/desktop/smoke.sh
#
# The smoke test passes when the window is up, the style sheet parsed and the
# program of the first terminal is running (SHADOW-SMOKE-OK org.shadow.terminal).
shadow-terminal
# the same with an explicit command as argument vector instead of the profile's shell
shadow-terminal --workdir /tmp -e /bin/sh
