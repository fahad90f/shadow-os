# <binary> [arguments...] — each line is launched by tests/desktop/smoke.sh
# Without the override the tools are looked for in /usr/sbin (absent in the
# build chroot): the honest "not installed" state.
nexus-security-center
nexus-security-center --page firewall
# With the developer override the real tools from the source tree are run.
nexus-security-center --tools-dir /src/security
nexus-security-center --tools-dir /src/security --page firewall
nexus-security-center --tools-dir /src/security --page apparmor
nexus-security-center --tools-dir /src/security --page encryption
nexus-security-center --tools-dir /src/security --page secureboot
nexus-security-center --tools-dir /src/security --page updates
nexus-security-center --tools-dir /src/security --page hardening
nexus-security-center --tools-dir /src/security --page network
nexus-security-center --tools-dir /src/security --page services
nexus-security-center --tools-dir /src/security --page logins
# Populated states (installed machine with UEFI, LUKS, AppArmor, systemd) from
# the fixed test report in tests/fixture; tests/fixture-proposed adds the
# fields requested from the real tool (README.md).
nexus-security-center --tools-dir /src/applications/security-center/tests/fixture
nexus-security-center --tools-dir /src/applications/security-center/tests/fixture --page firewall
nexus-security-center --tools-dir /src/applications/security-center/tests/fixture --page apparmor
nexus-security-center --tools-dir /src/applications/security-center/tests/fixture --page encryption
nexus-security-center --tools-dir /src/applications/security-center/tests/fixture --page secureboot
nexus-security-center --tools-dir /src/applications/security-center/tests/fixture --page updates
nexus-security-center --tools-dir /src/applications/security-center/tests/fixture --page hardening
nexus-security-center --tools-dir /src/applications/security-center/tests/fixture --page network
nexus-security-center --tools-dir /src/applications/security-center/tests/fixture --page services
nexus-security-center --tools-dir /src/applications/security-center/tests/fixture --page logins
nexus-security-center --tools-dir /src/applications/security-center/tests/fixture-proposed --page firewall
nexus-security-center --tools-dir /src/applications/security-center/tests/fixture-proposed --page apparmor
nexus-security-center --tools-dir /src/applications/security-center/tests/fixture-proposed --page encryption
nexus-security-center --tools-dir /src/applications/security-center/tests/fixture-proposed --page secureboot
nexus-security-center --tools-dir /src/applications/security-center/tests/fixture-proposed --page logins
nexus-security-center --tools-dir /src/applications/security-center/tests/fixture-proposed --page hardening
