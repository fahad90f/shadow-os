# <binary> [arguments...] — each line is launched by tests/desktop/smoke.sh
# Without the override the tools are looked for in /usr/sbin (absent in the
# build chroot): the honest "not installed" state.
shadow-security-center
shadow-security-center --page firewall
# With the developer override the real tools from the source tree are run.
shadow-security-center --tools-dir /src/security
shadow-security-center --tools-dir /src/security --page firewall
shadow-security-center --tools-dir /src/security --page apparmor
shadow-security-center --tools-dir /src/security --page encryption
shadow-security-center --tools-dir /src/security --page secureboot
shadow-security-center --tools-dir /src/security --page updates
shadow-security-center --tools-dir /src/security --page hardening
shadow-security-center --tools-dir /src/security --page network
shadow-security-center --tools-dir /src/security --page services
shadow-security-center --tools-dir /src/security --page logins
# Populated states (installed machine with UEFI, LUKS, AppArmor, systemd) from
# the fixed test report in tests/fixture; tests/fixture-proposed adds the
# fields requested from the real tool (README.md).
shadow-security-center --tools-dir /src/applications/security-center/tests/fixture
shadow-security-center --tools-dir /src/applications/security-center/tests/fixture --page firewall
shadow-security-center --tools-dir /src/applications/security-center/tests/fixture --page apparmor
shadow-security-center --tools-dir /src/applications/security-center/tests/fixture --page encryption
shadow-security-center --tools-dir /src/applications/security-center/tests/fixture --page secureboot
shadow-security-center --tools-dir /src/applications/security-center/tests/fixture --page updates
shadow-security-center --tools-dir /src/applications/security-center/tests/fixture --page hardening
shadow-security-center --tools-dir /src/applications/security-center/tests/fixture --page network
shadow-security-center --tools-dir /src/applications/security-center/tests/fixture --page services
shadow-security-center --tools-dir /src/applications/security-center/tests/fixture --page logins
shadow-security-center --tools-dir /src/applications/security-center/tests/fixture-proposed --page firewall
shadow-security-center --tools-dir /src/applications/security-center/tests/fixture-proposed --page apparmor
shadow-security-center --tools-dir /src/applications/security-center/tests/fixture-proposed --page encryption
shadow-security-center --tools-dir /src/applications/security-center/tests/fixture-proposed --page secureboot
shadow-security-center --tools-dir /src/applications/security-center/tests/fixture-proposed --page logins
shadow-security-center --tools-dir /src/applications/security-center/tests/fixture-proposed --page hardening
