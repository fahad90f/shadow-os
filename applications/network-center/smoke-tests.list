# <binary> [arguments...] — each line is launched by tests/desktop/smoke.sh
# One launch per page, so every page's QML is loaded and checked for warnings.
shadow-network-center
shadow-network-center --page wifi
shadow-network-center --page interfaces
shadow-network-center --page ip
shadow-network-center --page dns
shadow-network-center --page routes
shadow-network-center --page connections
shadow-network-center --page vpn
shadow-network-center --page diagnostics
shadow-network-center --page capture
