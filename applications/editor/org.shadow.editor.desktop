[Desktop Entry]
Type=Application
Name=Text Editor
GenericName=Text Editor
Comment=Edit source code and plain text files
Exec=shadow-editor %F
Icon=org.shadow.editor
Terminal=false
Categories=Utility;TextEditor;Development;
Keywords=text;editor;code;source;notes;plain;programming;
MimeType=text/plain;text/markdown;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-python;text/x-python3;application/x-shellscript;text/x-shellscript;application/json;application/xml;text/xml;text/html;text/css;application/javascript;text/javascript;application/x-yaml;text/x-yaml;application/toml;text/x-rust;text/x-go;text/x-java;text/x-cmake;text/x-makefile;text/x-qml;text/x-patch;text/x-diff;text/x-log;text/csv;text/x-tex;text/x-lua;text/x-perl;application/x-perl;application/x-ruby;text/x-ruby;application/x-php;text/x-sql;application/sql;text/x-ini;application/x-desktop;text/x-systemd-unit;text/x-dockerfile;text/x-typescript;application/typescript;text/x-kotlin;text/x-csharp;text/x-haskell;text/x-readme;
StartupNotify=true
StartupWMClass=org.shadow.editor
X-SHADOW-Component=editor
