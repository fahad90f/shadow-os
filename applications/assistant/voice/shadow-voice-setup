        --dest=*) MODE=dest; DEST=${1#--dest=} ;;
        --stt) [ $# -ge 2 ] || { echo "$PROG: --stt needs moonshine, whisper or both" >&2; exit $E_USAGE; }; STT=$2; shift ;;
        --stt=*) STT=${1#--stt=} ;;
        --cache) [ $# -ge 2 ] || { echo "$PROG: --cache needs a directory" >&2; exit $E_USAGE; }; CACHE=$2; shift ;;
        --cache=*) CACHE=${1#--cache=} ;;
        --offline-cache) [ $# -ge 2 ] || { echo "$PROG: --offline-cache needs a directory" >&2; exit $E_USAGE; }; OFFLINE=$2; shift ;;
        --offline-cache=*) OFFLINE=${1#--offline-cache=} ;;
        --numpy) [ $# -ge 2 ] || { echo "$PROG: --numpy needs auto, system or wheel" >&2; exit $E_USAGE; }; NUMPY=$2; shift ;;
        --numpy=*) NUMPY=${1#--numpy=} ;;
        --python) [ $# -ge 2 ] || { echo "$PROG: --python needs a path" >&2; exit $E_USAGE; }; PY=$2; shift ;;
        --python=*) PY=${1#--python=} ;;
        --progress-json) PROGRESS=1 ;;
        --check) ACTION=check ;;
        --uninstall) ACTION=uninstall ;;
        --yes|-y) YES=1 ;;
        --install-deps) INSTALL_DEPS=1 ;;
        --no-selftest) SELFTEST=0 ;;
        --keep-cache) KEEP_CACHE=1 ;;
        -h|--help) usage; exit $E_OK ;;
        --version) echo "shadow-voice-setup $SETUP_VERSION"; exit $E_OK ;;
        *) echo "$PROG: unknown option '$1' (see --help)" >&2; exit $E_USAGE ;;
    esac
    shift
done
case "$STT" in moonshine|whisper|both) ;; *) echo "$PROG: --stt must be moonshine, whisper or both" >&2; exit $E_USAGE ;; esac
case "$NUMPY" in auto|system|wheel) ;; *) echo "$PROG: --numpy must be auto, system or wheel" >&2; exit $E_USAGE ;; esac

IS_ROOT=0; [ "$(id -u)" -eq 0 ] && IS_ROOT=1
[ -n "$MODE" ] || { if [ "$IS_ROOT" = 1 ]; then MODE=system; else MODE=user; fi; }
case "$MODE" in
    user) DEST="${XDG_DATA_HOME:-$HOME/.local/share}/shadow/voice"
          [ -n "$CACHE" ] || CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/shadow-voice" ;;
    system) DEST=/var/lib/shadow-voice
            [ -n "$CACHE" ] || CACHE=/var/cache/shadow-voice ;;
    dest) [ -n "$DEST" ] || { echo "$PROG: --dest needs a directory" >&2; exit $E_USAGE; }
          [ -n "$CACHE" ] || { if [ "$IS_ROOT" = 1 ]; then CACHE=/var/cache/shadow-voice; else CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/shadow-voice"; fi; } ;;
esac
