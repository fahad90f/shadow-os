#!/bin/bash
# shadow-voice-setup — install the offline voice engine data of Shadow Assistant.
#
# Downloads pinned, sha256-verified artifacts (sherpa-onnx runtime wheels, Silero
# VAD, the "Shadow" keyword spotter, Moonshine / Whisper speech recognition, the
# Kokoro voice), unpacks only the files the engine loads into a staging directory
# next to the destination, writes manifest.json and moves the result into place
# atomically, then runs `shadow-voiced --selftest`. Network is only used here;
# the engine itself runs fully offline.
#
#   shadow-voice-setup                 per user  ~/.local/share/shadow/voice (default when not root)
#   sudo shadow-voice-setup --system   system    /var/lib/shadow-voice       (default for root)
#   shadow-voice-setup --dest DIR      any root, e.g. <chroot>/usr/share/shadow-voice for an ISO
#
# Run `shadow-voice-setup --help` for every option and the exit codes.
set -euo pipefail
shopt -s nullglob

